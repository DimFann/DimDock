FROM python:3.11-slim
WORKDIR /app
COPY path_loader/requirements.txt path_loader/requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-test.txt
COPY path_loader/*.py ./
COPY init/01-create-tables.sql ./
ENTRYPOINT ["python", "-B", "-m", "unittest", "-v", "test_file_store", "test_load_paths", "test_build_shortcuts", "test_indexing"]
