<!DOCTYPE html>
@inject IConfiguration Configuration
@inject Website.Services.NavigationSettingsProvider NavigationSettingsProvider
@{
    var siteTitle = Configuration["SiteTitle"] ?? "DimDock";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isBlogPage = currentPage is "/Blog" or "/BlogPost";
    var isAdminEnabled = Configuration.GetValue<bool?>("Features:AdminEnabled") ?? true;
    var isAdminAuthenticated = User.IsInRole("Admin");
    var navigation = await NavigationSettingsProvider.GetAsync(Context.RequestAborted);
    var uploads = Configuration.GetSection("Uploads").Get<Website.Services.UploadOptions>() ?? new Website.Services.UploadOptions();
    string HeaderUrl(string page) => uploads.HeaderUrl(Context.Request,
        Url.Page(page) ?? throw new InvalidOperationException($"Header route not found: {page}"));
    var loginReturnUrl = currentPage == "/Login"
        ? Context.Request.Query["ReturnUrl"].ToString()
        : Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var loginUrl = HeaderUrl("/Login");
    if (!string.IsNullOrEmpty(loginReturnUrl))
    {
        loginUrl += "?ReturnUrl=" + Uri.EscapeDataString(loginReturnUrl);
    }
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteTitle</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/jetbrains-mono/wght.css" />
    <link rel="stylesheet" href="~/lib/jetbrains-mono/wght-italic.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/editors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gallery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/image.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/comic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/website.styles.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light site-header border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" href="@HeaderUrl("/Index")">
                    <img class="site-logo" src="~/img/greenfan.png" asp-append-version="true" width="32" height="32" alt="" />
                    <span>@siteTitle</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Index" ? "active" : "")"
                               aria-current="@(currentPage == "/Index" ? "page" : null)"
                               href="@HeaderUrl("/Index")">Home</a>
                        </li>
                        @if (navigation.Gallery || isAdminAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Gallery" ? "active" : "") @(!navigation.Gallery ? "admin-only-tagged" : "")"
                                   aria-current="@(currentPage == "/Gallery" ? "page" : null)"
                                   href="@HeaderUrl("/Gallery")">Gallery</a>
                            </li>
                        }
                        @if (navigation.Search || isAdminAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Search" ? "active" : "") @(!navigation.Search ? "admin-only-tagged" : "")"
                                   aria-current="@(currentPage == "/Search" ? "page" : null)"
                                   href="@HeaderUrl("/Search")">Search</a>
                            </li>
                        }
                        @if (navigation.Blog || isAdminAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isBlogPage ? "active" : "") @(!navigation.Blog ? "admin-only-tagged" : "")"
                                   aria-current="@(isBlogPage ? "page" : null)"
                                   href="@HeaderUrl("/Blog")">Blog</a>
                            </li>
                        }
                        @if (navigation.Commissions || isAdminAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Commissions" ? "active" : "") @(!navigation.Commissions ? "admin-only-tagged" : "")"
                                   aria-current="@(currentPage == "/Commissions" ? "page" : null)"
                                   href="@HeaderUrl("/Commissions")">Commissions</a>
                            </li>
                        }
                        @if (isAdminEnabled && isAdminAuthenticated)
                        {
                            <li class="nav-item site-header-separator" aria-hidden="true">|</li>
                        }
                        @if (isAdminEnabled && isAdminAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Admin" ? "active" : "")"
                                   aria-current="@(currentPage == "/Admin" ? "page" : null)"
                                   href="@HeaderUrl("/Admin")">Admin</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Settings" ? "active" : "")"
                               aria-current="@(currentPage == "/Settings" ? "page" : null)"
                               href="@HeaderUrl("/Settings")">Settings</a>
                        </li>
                        @if (isAdminEnabled && !isAdminAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Login" ? "active" : "")"
                                   aria-current="@(currentPage == "/Login" ? "page" : null)"
                                   href="@loginUrl">Login</a>
                            </li>
                        }
                        @if (isAdminAuthenticated)
                        {
                            <li class="nav-item">
                                <form method="post" asp-page="/Login" asp-page-handler="Logout">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ReturnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
                                    <button type="submit" class="nav-link border-0 bg-transparent">Logout</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container site-content-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
