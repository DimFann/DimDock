@model GalleryModel

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p class="gallery-message">@Model.Message</p>
}

<div class="gallery-top-layout">
    <div class="gallery-directory">
        <table class="gallery-directory-table">
            <tr class="gallery-directory-row-even">
                <td><a href="/Gallery">/</a></td>
            </tr>
            <tr class="gallery-directory-row-odd">
                <td>
                    <a href="@($"/Gallery/{(Model.ParentPath == "root" ? "" : Model.ParentPath)}")">..</a>
                </td>
            </tr>
            @if (Model.DirectoryLinks.Any())
            {
                var rowIndex = 0;
                foreach (var link in Model.DirectoryLinks)
                {
                    var rowClass = rowIndex % 2 == 0 ? "gallery-directory-row-even" : "gallery-directory-row-odd";
                    var target = link.Path == "root" ? "" :
                        string.Join("/", link.Path.Split('/').Select(Uri.EscapeDataString));
                    <tr class="@rowClass">
                        <td>
                            <a class="@(link.IsAdminOnly ? "admin-only-tagged" : "")"
                               title="@(link.IsShortcut ? $"Directory shortcut to {link.Path}" : null)"
                               href="@($"/Gallery/{target}")">@link.Name</a>
                        </td>
                    </tr>
                    rowIndex++;
                }
            }
        </table>
        @if (Model.AdminEnabled || !string.IsNullOrWhiteSpace(Model.PathEntry?.Description))
        {
            var hasDescription = !string.IsNullOrWhiteSpace(Model.PathEntry?.Description);
            <div class="path-description-section gallery-path-description">
                <div class="path-description-wrapper @(hasDescription ? "has-description" : "")" data-path-description-wrapper>
                    @if (Model.AdminEnabled)
                    {
                        <button type="button"
                                class="description-editor-button description-edit-icon"
                                data-open-description-editor
                                aria-label="@(hasDescription ? "Edit description" : "Add description")"
                                title="@(hasDescription ? "Edit description" : "Add description")">
                            @if (hasDescription)
                            {
                                <img src="/img/edit.png" alt="" />
                            }
                            else
                            {
                                <img src="/img/add.png" alt="" />
                            }
                        </button>
                    }
                    <div class="path-description-content"
                         data-path-description
                         data-open-description-viewer
                         role="button"
                         tabindex="0"
                         aria-haspopup="dialog"
                         aria-label="View full description">
                        @Html.Raw(Model.RenderMarkdown(Model.PathEntry?.Description))
                    </div>
                </div>
            </div>
        }
        @if (Model.AdminEnabled ||
             (Model.PathEntry?.TagLinks.Any(link => !Model.AdminOnlyTags.Contains(link.Tag.Name)) ?? false))
        {
            var directoryTags = Model.PathEntry?.TagLinks
                .Select(link => link.Tag.Name)
                .Where(tag => Model.AdminEnabled || !Model.AdminOnlyTags.Contains(tag))
                .OrderBy(name => name, StringComparer.Ordinal)
                .ToList() ?? new List<string>();
            <section class="path-tags-section" aria-label="Directory tags">
                @if (Model.AdminEnabled)
                {
                    <form method="post" class="directory-tag-editor" data-directory-tags-form>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="path" value="@Model.CurrentPath" />
                        <div class="directory-tag-input-wrapper">
                            <input id="directoryTags"
                                   name="tags"
                                   maxlength="4000"
                                   placeholder="Tags..."
                                   aria-label="Directory tags, comma-separated"
                                   value="@string.Join(", ", directoryTags)" />
                            <button type="submit" class="icon-action-button directory-tag-save" aria-label="Save tags" title="Save tags">
                                <img src="/img/save.png" alt="" />
                            </button>
                        </div>
                        <p class="description-editor-error" data-directory-tag-error role="alert"></p>
                    </form>
                }
                else
                {
                    <div class="path-tags-row">
                        <span class="tag-links" data-directory-tag-list>
                            @await Html.PartialAsync("_TagLinks", new Website.Models.TagListModel(directoryTags))
                        </span>
                    </div>
                }
            </section>
        }
    </div>
</div>

<dialog class="path-description-dialog" data-description-viewer aria-labelledby="pathDescriptionViewerTitle">
    <div class="path-description-dialog-header">
        <h2 id="pathDescriptionViewerTitle">Description</h2>
        <button type="button" class="icon-action-button" data-close-description-viewer aria-label="Close description" title="Close">
            <img src="/img/cancel.png" alt="" />
        </button>
    </div>
    <div class="path-description-dialog-content" data-full-description></div>
</dialog>

@if (Model.AdminEnabled)
{
    <dialog class="description-editor" data-description-editor aria-labelledby="descriptionEditorTitle">
        <form method="post" data-description-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="path" value="@Model.CurrentPath" />
            <h2 id="descriptionEditorTitle" data-description-editor-title>Edit Description</h2>
            <section class="description-editor-pane" data-description-edit-pane>
                <div class="description-editor-actions">
                    <div class="description-editor-actions-left">
                        <button type="button" class="icon-action-button" data-preview-description aria-label="Preview description" title="Preview">
                            <img src="/img/preview.png" alt="" />
                        </button>
                    </div>
                    <div class="description-editor-actions-right">
                        <button type="button" class="icon-action-button" data-close-description-editor aria-label="Cancel editing" title="Cancel">
                            <img src="/img/cancel.png" alt="" />
                        </button>
                        <button type="submit" class="icon-action-button" aria-label="Save description" title="Save">
                            <img src="/img/save.png" alt="" />
                        </button>
                    </div>
                </div>
                <textarea name="description" data-description-markdown aria-label="Description Markdown">@Model.PathEntry?.Description</textarea>
            </section>
            <section class="description-editor-pane description-editor-preview-pane" data-description-preview-pane hidden>
                <div class="description-editor-actions">
                    <div class="description-editor-actions-left">
                        <button type="button" class="icon-action-button" data-edit-description aria-label="Edit description" title="Edit">
                            <img src="/img/edit.png" alt="" />
                        </button>
                    </div>
                    <div class="description-editor-actions-right">
                        <button type="button" class="icon-action-button" data-close-description-editor aria-label="Cancel editing" title="Cancel">
                            <img src="/img/cancel.png" alt="" />
                        </button>
                        <button type="submit" class="icon-action-button" aria-label="Save description" title="Save">
                            <img src="/img/save.png" alt="" />
                        </button>
                    </div>
                </div>
                <div class="description-editor-preview blog-post-content" data-description-preview aria-live="polite"></div>
            </section>
            <p class="description-editor-error" data-description-error role="alert"></p>
        </form>
    </dialog>
}

<hr class="gallery-separator" hidden="@(Model.Items.Count == 0 && !string.Equals(Model.PathEntry?.Type, "comic", StringComparison.OrdinalIgnoreCase))" />

<!-- Image grid -->
@if (Model.Items.Any())
{
    <div class="gallery-image-grid" data-gallery-grid hidden="@(string.Equals(Model.PathEntry?.Type, "comic", StringComparison.OrdinalIgnoreCase))">
        @foreach (var item in Model.Items)
        {
            var adminOnlyItem = item.TagLinks.Any(link => Model.AdminOnlyTags.Contains(link.Tag.Name));
            <div class="gallery-image-result @(adminOnlyItem ? "admin-only-tagged" : "")" data-gallery-item-id="@item.Id">
                @if (Model.AdminEnabled)
                {
                    <label class="gallery-bulk-select">
                        <input type="checkbox"
                               value="@item.Id"
                               data-bulk-select-item
                               data-shortcut-id="@item.ShortcutId" />
                        <span class="visually-hidden">Select @item.OriginalName</span>
                    </label>
                }
                <a href="@(item.ShortcutId is ulong shortcutId ? $"/image/{item.Id}?shortcutId={shortcutId}" : $"/image/{item.Id}")" class="gallery-image-link">
                    @if (item.IsImage)
                    {
                        <img src="@($"/img_db_thumbs/{item.ThumbnailKey}.png")"
                             alt="@item.OriginalName"
                             class="gallery-image-thumbnail"
                             data-gallery-item-thumbnail />
                    }
                    else
                    {
                        <span class="gallery-file-thumbnail">
                            <img src="/img/file.png" alt="" />
                            <span data-gallery-item-file-name>@item.OriginalName</span>
                        </span>
                    }
                    @if (item.ShortcutId.HasValue)
                    {
                        <img src="/img/link.png" alt="" class="gallery-shortcut-icon" title="Shortcut" />
                    }
                </a>
                @if (Model.AdminEnabled)
                {
                    <div class="gallery-item-name">
                        <span class="gallery-item-name-text" data-gallery-item-name title="@item.OriginalName">@item.OriginalName</span>
                        <button type="button"
                                class="icon-action-button gallery-item-rename-button"
                                data-open-rename-item
                                data-item-id="@item.Id"
                                aria-label="Rename @item.OriginalName"
                                title="Rename">
                            <img src="/img/edit.png" alt="" />
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@if (Model.AdminEnabled || string.Equals(Model.PathEntry?.Type, "comic", StringComparison.OrdinalIgnoreCase))
{
    var comicItems = Model.Items
        .Select(item => new { Item = item, LeadingNumber = Model.GetComicLeadingNumber(item.OriginalName) })
        .OrderBy(entry => entry.LeadingNumber is null)
        .ThenBy(entry => entry.LeadingNumber)
        .ThenBy(entry => entry.Item.OriginalName, StringComparer.OrdinalIgnoreCase)
        .Select(entry => entry.Item)
        .ToList();
    var firstItem = comicItems.FirstOrDefault();
    <section class="comic-viewer"
             data-comic-viewer
             data-comic-count="@comicItems.Count"
             hidden="@(!string.Equals(Model.PathEntry?.Type, "comic", StringComparison.OrdinalIgnoreCase))">
        <div class="comic-image-pane">
            @if (firstItem is not null)
            {
                <img data-comic-image alt="@firstItem.OriginalName" />
            }
            else
            {
                <p>No images in this directory.</p>
            }
        </div>
        <div class="comic-pages" hidden>
            @foreach (var item in comicItems)
            {
                <span data-source="@Model.GetSourceUrl(item)" data-name="@item.OriginalName"></span>
            }
        </div>
        @if (comicItems.Count > 0)
        {
            <div class="comic-controls">
                <a class="icon-action-button comic-source-link" href="@Model.GetSourceUrl(firstItem!)" aria-label="View source" title="View source">
                    <img src="/img/goto.png" alt="" />
                </a>
                <div class="comic-page-navigation" aria-label="Comic page navigation">
                    <button type="button" class="icon-action-button" data-comic-first aria-label="First page" title="First page">
                        <img src="/img/first.png" alt="" />
                    </button>
                    <button type="button" class="icon-action-button" data-comic-prev aria-label="Previous page" title="Previous page">
                        <img src="/img/prev.png" alt="" />
                    </button>
                    <button type="button" class="icon-action-button" data-comic-next aria-label="Next page" title="Next page">
                        <img src="/img/next.png" alt="" />
                    </button>
                    <button type="button" class="icon-action-button" data-comic-last aria-label="Last page" title="Last page">
                        <img src="/img/last.png" alt="" />
                    </button>
                </div>
                <a class="icon-action-button comic-download-link" href="@Model.GetSourceUrl(firstItem!)" download aria-label="Download image" title="Download">
                    <img src="/img/save.png" alt="" />
                </a>
            </div>
        }
    </section>
}
