@page "{*path}"
@model GalleryModel
@{
    ViewData["Title"] = "Gallery";
    ViewData["BodyClass"] = "content-background gallery-wide";
}

<div class="gallery-page-container">
    <div class="gallery-heading">
        <h4>@Model.Path</h4>
        @if (Model.AdminEnabled && Model.PathEntry is not null)
        {
            <form method="post" asp-page-handler="SavePathType" class="path-type-form" data-path-type-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="path" value="@Model.CurrentPath" />
                <label for="pathType">Display type</label>
                <select id="pathType"
                        name="type"
                        aria-label="Directory display type"
                        data-saved-value="@(string.Equals(Model.PathEntry.Type, "comic", StringComparison.OrdinalIgnoreCase) ? "comic" : "")">
                    <option value="" selected="@(string.Equals(Model.PathEntry.Type, "comic", StringComparison.OrdinalIgnoreCase) ? null : "selected")">Default (Gallery)</option>
                    <option value="comic" selected="@(string.Equals(Model.PathEntry.Type, "comic", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Comic</option>
                </select>
                <span class="path-type-status" data-path-type-status role="status"></span>
            </form>
        }
        <div id="loadingSpinner"></div>
    </div>

    <!-- Results container spans full width -->
    <div id="galleryResults">
        @await Html.PartialAsync("_GalleryResults", Model)
    </div>
</div>

<script>
    document.addEventListener("change", async (event) => {
        const select = event.target.closest("[data-path-type-form] select[name='type']");
        if (!select) {
            return;
        }

        const form = select.form;
        const status = form.querySelector("[data-path-type-status]");
        const previousValue = select.dataset.savedValue ?? "";
        status.textContent = "Saving...";
        try {
            const response = await fetch(form.action, {
                method: "POST",
                body: new FormData(form),
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            if (!response.ok) {
                throw new Error(await response.text() || "Saving display type failed.");
            }
            select.dataset.savedValue = select.value;
            status.textContent = "Saved";
        } catch (error) {
            select.value = previousValue;
            status.textContent = error.message;
        }
    });

    document.addEventListener("click", async (event) => {
        const openButton = event.target.closest("[data-open-description-editor]");
        if (openButton) {
            const dialog = document.querySelector("[data-description-editor]");
            dialog.querySelector("[data-description-preview-pane]").hidden = true;
            dialog.querySelector("[data-description-edit-pane]").hidden = false;
            dialog.querySelector("[data-description-editor-title]").textContent = "Edit Description";
            dialog.querySelector("[data-description-error]").textContent = "";
            dialog.showModal();
            dialog.querySelector("[data-description-markdown]").focus();
            return;
        }

        if (event.target.closest("[data-close-description-editor]")) {
            document.querySelector("[data-description-editor]").close();
            return;
        }

        if (event.target.closest("[data-edit-description]")) {
            const dialog = document.querySelector("[data-description-editor]");
            dialog.querySelector("[data-description-preview-pane]").hidden = true;
            dialog.querySelector("[data-description-edit-pane]").hidden = false;
            dialog.querySelector("[data-description-editor-title]").textContent = "Edit Description";
            dialog.querySelector("[data-description-markdown]").focus();
            return;
        }

        if (event.target.closest("[data-preview-description]")) {
            const dialog = event.target.closest("[data-description-editor]");
            const form = dialog.querySelector("[data-description-form]");
            const preview = form.querySelector("[data-description-preview]");
            const error = form.querySelector("[data-description-error]");
            const url = new URL(window.location.href);
            url.searchParams.set("handler", "PreviewDescription");
            error.textContent = "";

            try {
                const response = await fetch(url, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) {
                    throw new Error(await response.text() || "Preview failed.");
                }
                preview.innerHTML = await response.text();
                form.querySelector("[data-description-edit-pane]").hidden = true;
                form.querySelector("[data-description-preview-pane]").hidden = false;
                dialog.querySelector("[data-description-editor-title]").textContent = "Preview";
            } catch (requestError) {
                error.textContent = requestError.message;
            }
        }

    });

    document.addEventListener("submit", async (event) => {
        const tagForm = event.target.closest("[data-directory-tags-form]");
        if (tagForm) {
            event.preventDefault();
            const error = tagForm.querySelector("[data-directory-tag-error]");
            error.textContent = "";
            const url = new URL(window.location.href);
            url.searchParams.set("handler", "SaveDirectoryTags");

            try {
                const response = await fetch(url, {
                    method: "POST",
                    body: new FormData(tagForm),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) {
                    throw new Error(await response.text() || "Saving directory tags failed.");
                }

                const result = await response.json();
                tagForm.querySelector("input[name='tags']").value = result.tags.join(", ");
            } catch (requestError) {
                error.textContent = requestError.message;
            }
            return;
        }

        const form = event.target.closest("[data-description-form]");
        if (!form) {
            return;
        }

        event.preventDefault();
        const error = form.querySelector("[data-description-error]");
        error.textContent = "";
        const url = new URL(window.location.href);
        url.searchParams.set("handler", "SaveDescription");

        try {
            const response = await fetch(url, {
                method: "POST",
                body: new FormData(form),
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            if (!response.ok) {
                throw new Error(await response.text() || "Save failed.");
            }

            const result = await response.json();
            const content = document.querySelector("[data-path-description]");
            const wrapper = document.querySelector("[data-path-description-wrapper]");
            const button = wrapper.querySelector("[data-open-description-editor]");
            content.innerHTML = result.html;
            content.hidden = !result.hasDescription;
            wrapper.classList.toggle("has-description", result.hasDescription);
            button.classList.toggle("description-add-icon", !result.hasDescription);
            button.classList.toggle("description-edit-icon", result.hasDescription);
            button.classList.toggle("icon-action-button", !result.hasDescription);
            button.classList.toggle("description-editor-button", result.hasDescription);
            button.setAttribute("aria-label", result.hasDescription ? "Edit description" : "Add description");
            button.title = result.hasDescription ? "Edit description" : "Add description";
            button.replaceChildren();
            const icon = document.createElement("img");
            icon.src = result.hasDescription ? "/img/edit.png" : "/img/add.png";
            icon.alt = "";
            button.append(icon);
            document.querySelector("[data-description-editor]").close();
        } catch (requestError) {
            error.textContent = requestError.message;
        }
    });
</script>
