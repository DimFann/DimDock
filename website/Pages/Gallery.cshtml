@page "{*path}"
@model GalleryModel
@{
    ViewData["Title"] = "Gallery";
    ViewData["BodyClass"] = "content-background gallery-wide";
}

<div class="gallery-page-container">
    @if (Model.AdminEnabled && Model.PathEntry is not null)
    {
        <div class="admin-options-toolbar">
            <strong class="admin-options-toolbar-title">Admin Options</strong>
            <form method="post" asp-page-handler="SavePathType" class="path-type-form" data-path-type-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="path" value="@Model.CurrentPath" />
                <label for="pathType">Display type</label>
                <select id="pathType"
                        name="type"
                        aria-label="Directory display type"
                        data-saved-value="@(string.Equals(Model.PathEntry.Type, "comic", StringComparison.OrdinalIgnoreCase) ? "comic" : "")">
                    <option value="" selected="@(string.Equals(Model.PathEntry.Type, "comic", StringComparison.OrdinalIgnoreCase) ? null : "selected")">Default (Gallery)</option>
                    <option value="comic" selected="@(string.Equals(Model.PathEntry.Type, "comic", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Comic</option>
                </select>
                <span class="path-type-status" data-path-type-status role="status"></span>
            </form>
            <button type="button" class="path-admin-button" data-open-add-path>Add Path</button>
            <button type="button" class="path-admin-button" data-open-upload-picker>Upload Images</button>
            <input type="file"
                   accept=".jpg,.jpeg,.png,.gif,image/jpeg,image/png,image/gif"
                   multiple
                   hidden
                   data-upload-picker />
            <div class="path-upload-status" data-upload-status hidden aria-live="polite">
                <progress max="100" value="0" data-upload-progress></progress>
                <span data-upload-message role="status"></span>
                <button type="button" data-refresh-gallery hidden>Refresh gallery</button>
            </div>
            @if (!string.Equals(Model.CurrentPath, "root", StringComparison.OrdinalIgnoreCase))
            {
                <button type="button" class="path-admin-button path-admin-delete" data-open-delete-path>Delete Path</button>
            }
        </div>
    }
    @if (Model.AdminEnabled && Model.PathEntry is not null)
    {
        <dialog class="path-description-dialog path-admin-dialog" data-add-path-dialog aria-labelledby="addPathTitle">
            <form method="post" data-add-path-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="parentPath" value="@Model.CurrentPath" />
                <div class="path-description-dialog-header">
                    <h2 id="addPathTitle">Add Path</h2>
                    <button type="button" class="icon-action-button" data-close-path-dialog aria-label="Close" title="Close">
                        <img src="/img/cancel.png" alt="" />
                    </button>
                </div>
                <label class="path-admin-field">
                    Path name
                    <input name="name" maxlength="255" pattern="[A-Za-z0-9_-]+" required
                           title="Use letters, numbers, underscores, and hyphens." />
                </label>
                <label class="path-admin-field">
                    Starter tags (comma-separated)
                    <input name="tags" maxlength="4000" />
                </label>
                <p class="description-editor-error" data-add-path-error role="alert"></p>
                <div class="path-admin-dialog-actions">
                    <button type="button" data-close-path-dialog>Cancel</button>
                    <button type="submit">Add Path</button>
                </div>
            </form>
        </dialog>

        @if (!string.Equals(Model.CurrentPath, "root", StringComparison.OrdinalIgnoreCase))
        {
            <dialog class="path-description-dialog path-admin-dialog" data-delete-path-dialog aria-labelledby="deletePathTitle">
                <form method="post" data-delete-path-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="path" value="@Model.CurrentPath" />
                    <div class="path-description-dialog-header">
                        <h2 id="deletePathTitle">Delete Path?</h2>
                        <button type="button" class="icon-action-button" data-close-path-dialog aria-label="Close" title="Close">
                            <img src="/img/cancel.png" alt="" />
                        </button>
                    </div>
                    <p>
                        This permanently removes <strong>@Model.CurrentPath</strong> and all child paths and contents from the database.
                        Its files and folders will be permanently deleted from disk the next time you run Sync DB to disk.
                        This cannot be undone.
                    </p>
                    <p class="description-editor-error" data-delete-path-error role="alert"></p>
                    <div class="path-admin-dialog-actions">
                        <button type="button" data-close-path-dialog>Cancel</button>
                        <button type="submit" class="path-admin-delete">Delete path and contents</button>
                    </div>
                </form>
            </dialog>
        }
    }
    <div class="gallery-heading">
        <h4>@Model.Path</h4>
        <div id="loadingSpinner"></div>
    </div>

    <!-- Results container spans full width -->
    <div id="galleryResults">
        @await Html.PartialAsync("_GalleryResults", Model)
    </div>
</div>

<script>
    const pathTypeSelect = document.querySelector("[data-path-type-form] select[name='type']");
    const comicViewer = document.querySelector("[data-comic-viewer]");
    const galleryGrid = document.querySelector("[data-gallery-grid]");
    const galleryDirectory = document.querySelector(".gallery-directory");
    const pathDescription = document.querySelector("[data-path-description]");
    let displayComicPage = () => {};

    function syncDescriptionHeight() {
        if (!pathDescription) {
            return;
        }

        if (window.matchMedia("(max-width: 767.98px)").matches || !galleryDirectory) {
            pathDescription.style.maxHeight = "";
            return;
        }

        pathDescription.style.maxHeight = `${Math.max(galleryDirectory.getBoundingClientRect().height, 400)}px`;
    }

    syncDescriptionHeight();
    if (galleryDirectory && pathDescription && "ResizeObserver" in window) {
        new ResizeObserver(syncDescriptionHeight).observe(galleryDirectory);
    }
    window.addEventListener("resize", syncDescriptionHeight);

    function setGalleryDisplayType(type) {
        const isComic = type === "comic";
        if (galleryGrid) {
            galleryGrid.hidden = isComic;
        }
        if (comicViewer) {
            comicViewer.hidden = !isComic;
            if (isComic) {
                displayComicPage(0);
            }
        }
    }

    if (pathTypeSelect) {
        setGalleryDisplayType(pathTypeSelect.value);
    }

    if (comicViewer) {
        const pages = Array.from(comicViewer.querySelectorAll(".comic-pages [data-source]"));
        const image = comicViewer.querySelector("[data-comic-image]");
        const sourceLink = comicViewer.querySelector(".comic-source-link");
        const downloadLink = comicViewer.querySelector(".comic-download-link");
        const pageButtons = {
            first: comicViewer.querySelector("[data-comic-first]"),
            prev: comicViewer.querySelector("[data-comic-prev]"),
            next: comicViewer.querySelector("[data-comic-next]"),
            last: comicViewer.querySelector("[data-comic-last]")
        };
        let currentPage = 0;

        displayComicPage = (index) => {
            if (pages.length === 0) {
                return;
            }

            currentPage = Math.max(0, Math.min(index, pages.length - 1));
            const page = pages[currentPage];
            image.src = page.dataset.source;
            image.alt = page.dataset.name;
            sourceLink.href = page.dataset.source;
            downloadLink.href = page.dataset.source;
            downloadLink.download = page.dataset.name;
            pageButtons.first.disabled = currentPage === 0;
            pageButtons.prev.disabled = currentPage === 0;
            pageButtons.next.disabled = currentPage === pages.length - 1;
            pageButtons.last.disabled = currentPage === pages.length - 1;
        };

        pageButtons.first?.addEventListener("click", () => displayComicPage(0));
        pageButtons.prev?.addEventListener("click", () => displayComicPage(currentPage - 1));
        pageButtons.next?.addEventListener("click", () => displayComicPage(currentPage + 1));
        pageButtons.last?.addEventListener("click", () => displayComicPage(pages.length - 1));
        if (comicViewer && !comicViewer.hidden) {
            displayComicPage(0);
        }
    }

    document.addEventListener("change", async (event) => {
        const select = event.target.closest("[data-path-type-form] select[name='type']");
        if (!select) {
            return;
        }

        setGalleryDisplayType(select.value);
        const form = select.form;
        const status = form.querySelector("[data-path-type-status]");
        const previousValue = select.dataset.savedValue ?? "";
        status.textContent = "Saving...";
        try {
            const response = await fetch(form.action, {
                method: "POST",
                body: new FormData(form),
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            if (!response.ok) {
                throw new Error(await response.text() || "Saving display type failed.");
            }
            select.dataset.savedValue = select.value;
            status.textContent = "Saved";
        } catch (error) {
            select.value = previousValue;
            setGalleryDisplayType(previousValue);
            status.textContent = error.message;
        }
    });

    document.addEventListener("click", async (event) => {
        const openButton = event.target.closest("[data-open-description-editor]");
        if (openButton) {
            const dialog = document.querySelector("[data-description-editor]");
            dialog.querySelector("[data-description-preview-pane]").hidden = true;
            dialog.querySelector("[data-description-edit-pane]").hidden = false;
            dialog.querySelector("[data-description-editor-title]").textContent = "Edit Description";
            dialog.querySelector("[data-description-error]").textContent = "";
            dialog.showModal();
            dialog.querySelector("[data-description-markdown]").focus();
            return;
        }

        const descriptionPreview = event.target.closest("[data-open-description-viewer]");
        if (descriptionPreview) {
            event.preventDefault();
            const dialog = document.querySelector("[data-description-viewer]");
            dialog.querySelector("[data-full-description]").innerHTML = descriptionPreview.innerHTML;
            dialog.showModal();
            return;
        }

        if (event.target.closest("[data-close-description-viewer]")) {
            document.querySelector("[data-description-viewer]").close();
            return;
        }

        if (event.target.closest("[data-close-description-editor]")) {
            document.querySelector("[data-description-editor]").close();
            return;
        }

        if (event.target.closest("[data-edit-description]")) {
            const dialog = document.querySelector("[data-description-editor]");
            dialog.querySelector("[data-description-preview-pane]").hidden = true;
            dialog.querySelector("[data-description-edit-pane]").hidden = false;
            dialog.querySelector("[data-description-editor-title]").textContent = "Edit Description";
            dialog.querySelector("[data-description-markdown]").focus();
            return;
        }

        if (event.target.closest("[data-preview-description]")) {
            const dialog = event.target.closest("[data-description-editor]");
            const form = dialog.querySelector("[data-description-form]");
            const preview = form.querySelector("[data-description-preview]");
            const error = form.querySelector("[data-description-error]");
            const url = new URL(window.location.href);
            url.searchParams.set("handler", "PreviewDescription");
            error.textContent = "";

            try {
                const response = await fetch(url, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) {
                    throw new Error(await response.text() || "Preview failed.");
                }
                preview.innerHTML = await response.text();
                form.querySelector("[data-description-edit-pane]").hidden = true;
                form.querySelector("[data-description-preview-pane]").hidden = false;
                dialog.querySelector("[data-description-editor-title]").textContent = "Preview";
            } catch (requestError) {
                error.textContent = requestError.message;
            }
        }

    });

    document.addEventListener("keydown", (event) => {
        const preview = event.target.closest("[data-open-description-viewer]");
        if (preview && (event.key === "Enter" || event.key === " ")) {
            event.preventDefault();
            preview.click();
        }
    });

    document.addEventListener("submit", async (event) => {
        const tagForm = event.target.closest("[data-directory-tags-form]");
        if (tagForm) {
            event.preventDefault();
            const error = tagForm.querySelector("[data-directory-tag-error]");
            error.textContent = "";
            const url = new URL(window.location.href);
            url.searchParams.set("handler", "SaveDirectoryTags");

            try {
                const response = await fetch(url, {
                    method: "POST",
                    body: new FormData(tagForm),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) {
                    throw new Error(await response.text() || "Saving directory tags failed.");
                }

                const result = await response.json();
                tagForm.querySelector("input[name='tags']").value = result.tags.join(", ");
            } catch (requestError) {
                error.textContent = requestError.message;
            }
            return;
        }

        const form = event.target.closest("[data-description-form]");
        if (!form) {
            return;
        }

        event.preventDefault();
        const error = form.querySelector("[data-description-error]");
        error.textContent = "";
        const url = new URL(window.location.href);
        url.searchParams.set("handler", "SaveDescription");

        try {
            const response = await fetch(url, {
                method: "POST",
                body: new FormData(form),
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            if (!response.ok) {
                throw new Error(await response.text() || "Save failed.");
            }

            const result = await response.json();
            const content = document.querySelector("[data-path-description]");
            const wrapper = document.querySelector("[data-path-description-wrapper]");
            const button = wrapper.querySelector("[data-open-description-editor]");
            content.innerHTML = result.html;
            content.hidden = !result.hasDescription;
            syncDescriptionHeight();
            document.querySelector("[data-full-description]").innerHTML = result.html;
            wrapper.classList.toggle("has-description", result.hasDescription);
            button.classList.toggle("description-add-icon", !result.hasDescription);
            button.classList.toggle("description-edit-icon", result.hasDescription);
            button.classList.toggle("icon-action-button", !result.hasDescription);
            button.classList.toggle("description-editor-button", result.hasDescription);
            button.setAttribute("aria-label", result.hasDescription ? "Edit description" : "Add description");
            button.title = result.hasDescription ? "Edit description" : "Add description";
            button.replaceChildren();
            const icon = document.createElement("img");
            icon.src = result.hasDescription ? "/img/edit.png" : "/img/add.png";
            icon.alt = "";
            button.append(icon);
            document.querySelector("[data-description-editor]").close();
        } catch (requestError) {
            error.textContent = requestError.message;
        }
    });
</script>

<script>
    const addPathDialog = document.querySelector("[data-add-path-dialog]");
    const deletePathDialog = document.querySelector("[data-delete-path-dialog]");
    const uploadPicker = document.querySelector("[data-upload-picker]");
    const uploadStatus = document.querySelector("[data-upload-status]");
    const uploadProgress = document.querySelector("[data-upload-progress]");
    const uploadMessage = document.querySelector("[data-upload-message]");
    const uploadButton = document.querySelector("[data-open-upload-picker]");
    const refreshGalleryButton = document.querySelector("[data-refresh-gallery]");

    document.addEventListener("click", (event) => {
        if (event.target.closest("[data-open-add-path]")) {
            addPathDialog.querySelector("[data-add-path-error]").textContent = "";
            addPathDialog.showModal();
            addPathDialog.querySelector("input[name='name']").focus();
            return;
        }

        if (event.target.closest("[data-open-delete-path]")) {
            deletePathDialog.querySelector("[data-delete-path-error]").textContent = "";
            deletePathDialog.showModal();
            return;
        }

        if (event.target.closest("[data-open-upload-picker]")) {
            uploadPicker.click();
            return;
        }

        if (event.target.closest("[data-refresh-gallery]")) {
            window.location.reload();
            return;
        }

        if (event.target.closest("[data-close-path-dialog]")) {
            event.target.closest("dialog").close();
        }
    });

    document.addEventListener("submit", async (event) => {
        const addForm = event.target.closest("[data-add-path-form]");
        const deleteForm = event.target.closest("[data-delete-path-form]");
        if (!addForm && !deleteForm) {
            return;
        }

        event.preventDefault();
        const form = addForm ?? deleteForm;
        const isAdd = Boolean(addForm);
        const error = form.querySelector(isAdd ? "[data-add-path-error]" : "[data-delete-path-error]");
        error.textContent = isAdd ? "Adding path..." : "Deleting path...";

        try {
            const url = new URL(window.location.href);
            url.searchParams.set("handler", isAdd ? "CreatePath" : "DeletePath");
            const response = await fetch(url, {
                method: "POST",
                body: new FormData(form),
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            if (!response.ok) {
                throw new Error(await response.text() || (isAdd ? "Adding path failed." : "Deleting path failed."));
            }

            const result = await response.json();
            if (isAdd) {
                const encodedPath = result.path.split("/").map(encodeURIComponent).join("/");
                window.location.assign(`/Gallery/${encodedPath}`);
            } else {
                window.location.assign(result.redirectPath);
            }
        } catch (requestError) {
            error.textContent = requestError.message;
        }
    });

    uploadPicker?.addEventListener("change", () => {
        if (uploadPicker.files.length === 0) {
            return;
        }

        const formData = new FormData();
        formData.append("path", "@Model.CurrentPath");
        formData.append("__RequestVerificationToken",
            document.querySelector("[data-add-path-form] input[name='__RequestVerificationToken']").value);
        for (const file of uploadPicker.files) {
            formData.append("files", file, file.name);
        }

        uploadStatus.hidden = false;
        uploadProgress.value = 0;
        uploadProgress.removeAttribute("value");
        refreshGalleryButton.hidden = true;
        uploadMessage.textContent = "Uploading selected files...";
        uploadButton.disabled = true;

        const request = new XMLHttpRequest();
        request.open("POST", new URL("?handler=Upload", window.location.href));
        request.setRequestHeader("X-Requested-With", "XMLHttpRequest");
        request.upload.addEventListener("progress", (event) => {
            if (!event.lengthComputable) {
                return;
            }

            uploadProgress.value = Math.round((event.loaded / event.total) * 100);
            uploadMessage.textContent = event.loaded === event.total
                ? "Generating thumbnails and saving to the gallery..."
                : `Uploading files: ${uploadProgress.value}%`;
        });
        request.addEventListener("load", () => {
            uploadButton.disabled = false;
            uploadPicker.value = "";
            if (request.status < 200 || request.status >= 300) {
                uploadProgress.value = 0;
                uploadMessage.textContent = request.responseText || "Upload failed.";
                return;
            }

            try {
                const result = JSON.parse(request.responseText);
                const successes = result.uploaded ?? [];
                const errors = result.errors ?? [];
                uploadProgress.value = 100;
                if (successes.length > 0) {
                    refreshGalleryButton.hidden = false;
                }

                const summary = `${successes.length} image${successes.length === 1 ? "" : "s"} uploaded.`;
                uploadMessage.textContent = errors.length > 0
                    ? `${summary} ${errors.join(" ")}`
                    : summary;
                if (errors.length === 0 && successes.length > 0) {
                    window.location.reload();
                }
            } catch {
                uploadMessage.textContent = "Upload completed, but the server response could not be read.";
            }
        });
        request.addEventListener("error", () => {
            uploadButton.disabled = false;
            uploadPicker.value = "";
            uploadMessage.textContent = "Upload failed because the connection was interrupted.";
        });
        request.addEventListener("abort", () => {
            uploadButton.disabled = false;
            uploadPicker.value = "";
            uploadMessage.textContent = "Upload canceled.";
        });
        request.send(formData);
    });
</script>
