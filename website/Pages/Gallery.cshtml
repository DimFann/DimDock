            const body = new FormData();
            body.append("path", "@Model.CurrentPath");
            body.append("__RequestVerificationToken", token);
            for (const [name, value] of Object.entries(fields)) {
                body.append(name, value);
            }
            const response = await fetch(handlerUrl(handler), {
                method: "POST",
                body,
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            if (!response.ok) {
                throw new Error(await response.text() || `${handler} failed.`);
            }
            return response.json();
        };
        const showProgress = (file, index, sentBytes) => {
            uploadProgress.value = Math.round(((finishedBytes + Math.min(sentBytes, file.size)) / totalBytes) * 100);
            uploadMessage.textContent = `Uploading ${file.name} (${index + 1} of ${files.length}): ${uploadProgress.value}%`;
        };
        // XHR (not fetch) so upload progress can be reported. offset = bytes of this file already sent.
        const send = (url, body, headers, file, index, offset) => new Promise((resolve, reject) => {
            if (uploadState.cancelled) {
                reject(Object.assign(new Error("upload canceled."), { cancelled: true }));
                return;
            }
            const request = new XMLHttpRequest();
            uploadState.request = request;
            request.open("POST", url);
            for (const [name, value] of Object.entries(headers)) {
                request.setRequestHeader(name, value);
            }
            request.upload.addEventListener("progress", (event) => {
                if (event.lengthComputable) {
                    showProgress(file, index, offset + event.loaded);
                }
            });
            request.addEventListener("loadend", () => {
                if (uploadState.request === request) {
                    uploadState.request = null;
                }
            });
            request.addEventListener("load", () => {
                if (request.status >= 200 && request.status < 300) {
                    resolve(request.responseText);
                    return;
                }
                const error = new Error(request.status === 413
                    ? "the request was too large for the server or proxy."
                    : request.responseText || `the server returned HTTP ${request.status}.`);
                error.retryable = request.status >= 500;
                reject(error);
            });
            request.addEventListener("error", () => reject(Object.assign(
                new Error("the connection was interrupted."), { retryable: true })));
            request.addEventListener("abort", () => reject(Object.assign(
                new Error("upload canceled."), { cancelled: true })));
            request.send(body);
        });
        const sendChunks = async (file, index, uploadId, chunkSize) => {
            const partCount = Math.max(1, Math.ceil(file.size / chunkSize));
            if (partCount > 10000) {
                throw new Error("the file is too large to upload in chunks.");
            }
            for (let partNumber = 1; partNumber <= partCount; partNumber++) {
                const offset = (partNumber - 1) * chunkSize;
                const chunk = file.slice(offset, offset + chunkSize);
                const url = handlerUrl("UploadChunk", {
                    path: "@Model.CurrentPath", fileName: file.name, uploadId, partNumber
                });
                for (let attempt = 1; ; attempt++) {
                    try {
                        await send(url, chunk, {
                            "Content-Type": "application/octet-stream",
                            "RequestVerificationToken": token,
                            "X-Requested-With": "XMLHttpRequest"
                        }, file, index, offset);
                        break;
                    } catch (chunkError) {
                        if (!chunkError.retryable || attempt >= 3 || uploadState.cancelled) {
                            throw chunkError;
                        }
                        uploadMessage.textContent = `Retrying ${file.name} chunk ${partNumber} of ${partCount}...`;
                        await new Promise((resolve) => setTimeout(resolve, attempt * 2000));
                    }
                }
            }
            return partCount;
        };

        uploadStatus.hidden = false;
        uploadProgress.value = 0;
        refreshGalleryButton.hidden = true;
        uploadButton.disabled = true;
        uploadState.running = true;
        uploadState.cancelled = false;
        cancelUploadButton.hidden = false;
        cancelUploadButton.disabled = false;
        const cancelled = [];

        for (const [index, file] of files.entries()) {
            if (uploadState.cancelled) {
                cancelled.push(file.name);
                continue;
            }
            uploadMessage.textContent = `Uploading ${file.name} (${index + 1} of ${files.length})...`;
            try {
                const begin = await postForm("BeginUpload", { fileName: file.name });
                if (begin.mode === "recover") {
                    if (!uploadState.cancelled &&
                        window.confirm(`${file.name} already exists in storage but is not registered in the gallery. Add the existing file to the gallery?`)) {
                        uploadMessage.textContent = `Recovering ${file.name}...`;
                        await postForm("CompleteUpload", { fileName: file.name });
                        uploaded.push(file.name);
                    } else {
                        skipped.push(file.name);
                    }
                } else if (begin.mode === "chunked") {
                    let partCount;
                    uploadState.chunked = { fileName: file.name, uploadId: begin.uploadId };
                    try {
                        partCount = await sendChunks(file, index, begin.uploadId, begin.chunkSize);
                    } catch (chunkError) {
                        uploadState.chunked = null;
                        await postForm("AbortUpload", { fileName: file.name, uploadId: begin.uploadId }).catch(() => {});
                        throw chunkError;
                    }
                    uploadState.chunked = null;
                    uploadMessage.textContent = `Saving ${file.name} to the gallery...`;
                    await postForm("CompleteUpload", { fileName: file.name, uploadId: begin.uploadId, partCount });
                    uploaded.push(file.name);
                } else {
                    const body = new FormData();
                    body.append("path", "@Model.CurrentPath");
                    body.append("__RequestVerificationToken", token);
                    body.append("files", file, file.name);
                    const result = JSON.parse(await send(handlerUrl("Upload"), body,
                        { "X-Requested-With": "XMLHttpRequest" }, file, index, 0));
                    uploaded.push(...(result.uploaded ?? []));
                    errors.push(...(result.errors ?? []));
                }
            } catch (uploadError) {
                if (uploadError.cancelled) {
                    cancelled.push(file.name);
                } else {
                    const message = uploadError.message;
                    errors.push(message.startsWith(file.name) ? message : `${file.name}: ${message}`);
                }
            }
            finishedBytes += file.size;
            uploadProgress.value = Math.round((finishedBytes / totalBytes) * 100);
        }

        uploadState.running = false;
        uploadState.request = null;
        cancelUploadButton.hidden = true;
        uploadButton.disabled = false;
        uploadProgress.value = 100;
        if (uploaded.length > 0) {
            refreshGalleryButton.hidden = false;
        }
        const summary = `${uploaded.length} file${uploaded.length === 1 ? "" : "s"} uploaded.`;
        const cancelledSummary = cancelled.length > 0 ? `Cancelled: ${cancelled.join(", ")}.` : "";
        const skippedSummary = skipped.length > 0 ? `Skipped recovery for: ${skipped.join(", ")}.` : "";
        uploadMessage.textContent = [summary, cancelledSummary, skippedSummary, ...errors].filter(Boolean).join(" ");
        if (errors.length === 0 && skipped.length === 0 && cancelled.length === 0 && uploaded.length > 0) {
            window.location.reload();
        }
    });
</script>
