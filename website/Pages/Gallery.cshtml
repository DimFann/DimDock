@page "{*path}"
@model GalleryModel
@{
    ViewData["Title"] = "Gallery";
    ViewData["BodyClass"] = "content-background";
}

@if (Model.AdminEnabled && Model.PathEntry is not null)
{
    <div class="admin-options-toolbar gallery-admin-toolbar">
        <div class="admin-options-toolbar-header">
            <strong class="admin-options-toolbar-title">Admin Options</strong>
            <div class="admin-toolbar-danger">
                @if (Model.UploadRedirectUrl is { } uploadRedirectUrl)
                {
                    <a class="path-admin-button" href="@uploadRedirectUrl" title="Continue to the upload host; sign in there if prompted, then click Upload to select files">Upload</a>
                }
                else
                {
                    <button type="button" class="path-admin-button" data-open-upload-picker>Upload</button>
                }
                @if (!string.Equals(Model.CurrentPath, "root", StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button" class="path-admin-button" data-open-rename-path>Rename Path</button>
                    <button type="button" class="path-admin-button" data-open-move-path>Move Path</button>
                    <button type="button" class="path-admin-button path-admin-delete delete-path-button" data-open-delete-path>Delete Path</button>
                }
            </div>
            <form method="post" asp-page-handler="SavePathType" class="path-type-form" data-path-type-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="path" value="@Model.CurrentPath" />
                <select id="pathType"
                        name="type"
                        aria-label="Directory display type"
                        data-saved-value="@(string.Equals(Model.PathEntry.Type, "comic", StringComparison.OrdinalIgnoreCase) ? "comic" : "")">
                    <option value="" selected="@(string.Equals(Model.PathEntry.Type, "comic", StringComparison.OrdinalIgnoreCase) ? null : "selected")">Default (Gallery)</option>
                    <option value="comic" selected="@(string.Equals(Model.PathEntry.Type, "comic", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Comic</option>
                </select>
                <span class="path-type-status" data-path-type-status role="status"></span>
            </form>
        </div>
        <div class="admin-options-toolbar-actions">
            <div class="admin-toolbar-action-group" aria-label="Gallery actions">
                <button type="button" class="path-admin-button" data-open-add-path>Add Path</button>
                <button type="button" class="path-admin-button" data-open-directory-shortcut>Shortcut To</button>
                @if (Model.Items.Count > 0)
                {
                    <button type="button" class="path-admin-button" data-toggle-bulk-select aria-pressed="false"
                            hidden="@string.Equals(Model.PathEntry?.Type, "comic", StringComparison.OrdinalIgnoreCase)">Select Items</button>
                    <label class="gallery-show-names-toggle"
                           hidden="@string.Equals(Model.PathEntry?.Type, "comic", StringComparison.OrdinalIgnoreCase)">
                        <input type="checkbox" data-toggle-item-names />
                        Names
                    </label>
                }
            </div>
            <div class="admin-toolbar-maintenance" aria-label="Path maintenance">
                <button type="button" class="path-admin-button" data-open-reload-path
                        title="Scan storage for this path and its subdirectories and index anything new">Reload Path</button>
            </div>
            @if (Model.Items.Count > 0)
            {
                <div class="bulk-delete-toolbar" data-bulk-selection-controls hidden aria-label="Bulk selection">
                    <div class="bulk-selection-heading">
                        <strong>Bulk selection</strong>
                        <span data-selected-item-count aria-live="polite">0 selected</span>
                    </div>
                    <div class="bulk-selection-actions">
                        <button type="button" class="path-admin-button" data-select-all-items>Select All</button>
                        <button type="button" class="path-admin-button" data-open-bulk-move disabled>Move Selected</button>
                        <button type="button" class="path-admin-button" data-open-bulk-tags disabled>Add Tags</button>
                        <button type="button" class="path-admin-button path-admin-delete" data-open-bulk-delete disabled>Delete selected</button>
                        <button type="button" class="path-admin-button" data-exit-bulk-select>Cancel Selection</button>
                    </div>
                </div>
            }
        </div>
        <input type="file"
               multiple
               hidden
               data-upload-picker />
        <div class="path-upload-status" data-upload-status hidden aria-live="polite">
            <progress max="100" value="0" data-upload-progress></progress>
            <span data-upload-message role="status"></span>
            <button type="button" data-cancel-upload hidden>Cancel upload</button>
            <button type="button" data-refresh-gallery hidden>Refresh gallery</button>
        </div>
    </div>
}

<div class="gallery-page-container gallery-view-container">
    @if (Model.AdminEnabled && Model.PathEntry is not null)
    {
        <dialog class="path-description-dialog path-admin-dialog" data-rename-item-dialog aria-labelledby="renameItemTitle">
            <form method="post" data-rename-item-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="itemId" />
                <div class="path-description-dialog-header">
                    <h2 id="renameItemTitle">Rename Item</h2>
                    <button type="button" class="icon-action-button" data-close-path-dialog aria-label="Close" title="Close">
                        <img src="/img/cancel.png" alt="" />
                    </button>
                </div>
                <label class="path-admin-field">
                    File name
                    <input name="newName" maxlength="255" required />
                </label>
                <p>The file extension must stay the same. Ordering updates when the page is refreshed.</p>
                <p class="description-editor-error" data-rename-item-error role="alert"></p>
                <div class="path-admin-dialog-actions">
                    <button type="button" data-close-path-dialog>Cancel</button>
                    <button type="submit">Rename</button>
                </div>
            </form>
        </dialog>

        <dialog class="path-description-dialog path-admin-dialog" data-add-path-dialog aria-labelledby="addPathTitle">
            <form method="post" data-add-path-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="parentPath" value="@Model.CurrentPath" />
                <div class="path-description-dialog-header">
                    <h2 id="addPathTitle">Add Path</h2>
                    <button type="button" class="icon-action-button" data-close-path-dialog aria-label="Close" title="Close">
                        <img src="/img/cancel.png" alt="" />
                    </button>
                </div>
                <label class="path-admin-field">
                    Path name
                    <input name="name" maxlength="255" pattern="[A-Za-z0-9_-]+" required
                           title="Use letters, numbers, underscores, and hyphens." />
                </label>
                <label class="path-admin-field">
                    Starter tags (comma-separated)
                    <input name="tags" maxlength="4000" />
                </label>
                <p class="description-editor-error" data-add-path-error role="alert"></p>
                <div class="path-admin-dialog-actions">
                    <button type="button" data-close-path-dialog>Cancel</button>
                    <button type="submit">Add Path</button>
                </div>
            </form>
        </dialog>

        <dialog class="path-description-dialog path-admin-dialog" data-reload-path-dialog aria-labelledby="reloadPathTitle">
            <form method="post" data-reload-path-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="path" value="@Model.CurrentPath" />
                <div class="path-description-dialog-header">
                    <h2 id="reloadPathTitle">Reload Path</h2>
                    <button type="button" class="icon-action-button" data-close-path-dialog aria-label="Close" title="Close">
                        <img src="/img/cancel.png" alt="" />
                    </button>
                </div>
                <p>
                    Scan storage for <strong>@Model.CurrentPath</strong> and all of its subdirectories, like the path loader does.
                    New files and directories are added, <code>.dimdock.json</code> tags, types and descriptions are applied,
                    and missing thumbnails are generated. Nothing is removed.
                </p>
                <p class="description-editor-error" data-reload-path-status role="status"></p>
                <div class="path-admin-dialog-actions">
                    <button type="button" data-close-path-dialog>Cancel</button>
                    <button type="submit" data-reload-path-submit>Reload</button>
                </div>
            </form>
        </dialog>

        @if (!string.Equals(Model.CurrentPath, "root", StringComparison.OrdinalIgnoreCase))
        {
            <dialog class="path-description-dialog path-admin-dialog" data-rename-path-dialog aria-labelledby="renamePathTitle">
                <form method="post" data-rename-path-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="path" value="@Model.CurrentPath" />
                    <div class="path-description-dialog-header">
                        <h2 id="renamePathTitle">Rename Path</h2>
                        <button type="button" class="icon-action-button" data-close-path-dialog aria-label="Close" title="Close">
                            <img src="/img/cancel.png" alt="" />
                        </button>
                    </div>
                    <p>Rename this directory and all of its child paths, preserving their contents and settings.</p>
                    <label class="path-admin-field">
                        New path name
                        <input name="newName"
                               maxlength="255"
                               pattern="[A-Za-z0-9_-]+"
                               value="@(Model.CurrentPath?.Split('/').LastOrDefault())"
                               required
                               title="Use letters, numbers, underscores, and hyphens." />
                    </label>
                    <p class="description-editor-error" data-rename-path-error role="alert"></p>
                    <div class="path-admin-dialog-actions">
                        <button type="button" data-close-path-dialog>Cancel</button>
                        <button type="submit">Rename path</button>
                    </div>
                </form>
            </dialog>

            <dialog class="path-description-dialog path-admin-dialog" data-delete-path-dialog aria-labelledby="deletePathTitle">
                <form method="post" data-delete-path-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="path" value="@Model.CurrentPath" />
                    <div class="path-description-dialog-header">
                        <h2 id="deletePathTitle">Delete Path?</h2>
                        <button type="button" class="icon-action-button" data-close-path-dialog aria-label="Close" title="Close">
                            <img src="/img/cancel.png" alt="" />
                        </button>
                    </div>
                    <p>
                        This permanently removes <strong>@Model.CurrentPath</strong> and all child paths and contents from the database.
                        Its files and folders will be permanently deleted from disk when you confirm.
                        This cannot be undone.
                    </p>
                    <p class="description-editor-error" data-delete-path-error role="alert"></p>
                    <div class="path-admin-dialog-actions">
                        <button type="button" data-close-path-dialog>Cancel</button>
                        <button type="submit" class="path-admin-delete">Delete path and contents</button>
                    </div>
                </form>
            </dialog>
        }

        <dialog class="path-description-dialog path-admin-dialog" data-bulk-delete-dialog aria-labelledby="bulkDeleteTitle">
            <form method="post" data-bulk-delete-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="path" value="@Model.CurrentPath" />
                <div data-bulk-delete-entries></div>
                <div class="path-description-dialog-header">
                    <h2 id="bulkDeleteTitle">Delete selected items?</h2>
                    <button type="button" class="icon-action-button" data-close-bulk-delete aria-label="Close" title="Close">
                        <img src="/img/cancel.png" alt="" />
                    </button>
                </div>
                <p data-bulk-delete-message></p>
                <p class="description-editor-error" data-bulk-delete-error role="alert"></p>
                <div class="path-admin-dialog-actions">
                    <button type="button" data-close-bulk-delete>Cancel</button>
                    <button type="submit" class="path-admin-button path-admin-delete">Delete selected</button>
                </div>
            </form>
        </dialog>

        <dialog class="path-description-dialog path-admin-dialog" data-bulk-tags-dialog aria-labelledby="bulkTagsTitle">
            <form method="post" asp-page-handler="BulkAddTags" data-bulk-tags-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="path" value="@Model.CurrentPath" />
                <div data-bulk-tags-entries></div>
                <div class="path-description-dialog-header">
                    <h2 id="bulkTagsTitle">Add tags to selected items</h2>
                    <button type="button" class="icon-action-button" data-close-bulk-tags aria-label="Close" title="Close">
                        <img src="/img/cancel.png" alt="" />
                    </button>
                </div>
                <label class="path-admin-field">
                    Tags to add (comma-separated)
                    <input name="tags" maxlength="4000" required />
                </label>
                <p>Existing tags are kept. Selecting a shortcut adds tags to its original item.</p>
                <p class="description-editor-error" data-bulk-tags-error role="alert"></p>
                <div class="path-admin-dialog-actions">
                    <button type="button" data-close-bulk-tags>Cancel</button>
                    <button type="submit">Add tags</button>
                </div>
            </form>
        </dialog>

        <dialog class="shortcut-dialog" data-bulk-move-dialog aria-labelledby="bulkMoveTitle">
            <form method="post" data-bulk-move-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="path" value="@Model.CurrentPath" />
                <div data-bulk-move-entries></div>
                <div class="path-description-dialog-header">
                    <h2 id="bulkMoveTitle">Move selected items</h2>
                    <button type="button" class="icon-action-button" data-close-bulk-move aria-label="Close" title="Close">
                        <img src="/img/cancel.png" alt="" />
                    </button>
                </div>
                <p data-move-path-note hidden>Moves this directory and all child directories, items, and shortcuts. The directory name stays the same. If the destination already has a directory with that name, the contents are merged; items that already exist there are left behind for cleanup.</p>
                <label for="bulkMovePathSearch">Search existing directories (enter / for root)</label>
                <input id="bulkMovePathSearch" type="search" autocomplete="off" data-bulk-move-path-search />
                <p class="shortcut-dialog-status" data-bulk-move-search-status role="status"></p>
                <ul class="shortcut-path-results" data-bulk-move-path-results></ul>
                <input type="hidden" name="targetPath" data-bulk-move-target-path />
                <p class="description-editor-error" data-bulk-move-error role="alert"></p>
                <div class="path-admin-dialog-actions">
                    <button type="button" data-close-bulk-move>Cancel</button>
                    <button type="submit" disabled data-bulk-move-submit>Move selected</button>
                </div>
            </form>
        </dialog>
    }
    <div class="gallery-heading">
        <h4>@Model.Path</h4>
        <div id="loadingSpinner"></div>
    </div>

    <!-- Results container spans full width -->
    <div id="galleryResults">
        @await Html.PartialAsync("_GalleryResults", Model)
    </div>
</div>

@if (!Model.AdminEnabled)
{
    <dialog class="path-description-dialog" data-gallery-age-confirmation
            data-adult-confirmed="@Model.AdultConfirmed.ToString().ToLowerInvariant()"
            aria-labelledby="galleryAgeConfirmationTitle">
        <form method="post" asp-page="/Settings" asp-page-handler="ConfirmAdult">
            <h2 id="galleryAgeConfirmationTitle">Adult content</h2>
            <p>This image is tagged NSFW. Confirm that you are 18 or older to continue.</p>
            <p>You can change NSFW filtering in <a asp-page="/Settings">Settings</a>.
                Images will stay blurred in the gallery unless you change that setting.</p>
            <p role="alert" data-gallery-age-error></p>
            <button type="button" data-cancel-gallery-age>Cancel</button>
            <button type="submit" name="confirmAdult" value="true">I am 18 or older</button>
        </form>
    </dialog>
}

<script src="~/js/gallery-age-confirmation.js" asp-append-version="true"></script>
@if (Model.AdminEnabled)
{
    <script src="~/js/gallery-path-operations.js" asp-append-version="true"></script>
}
<script>
    const pathTypeSelect = document.querySelector("[data-path-type-form] select[name='type']");
    const comicViewer = document.querySelector("[data-comic-viewer]");
    const galleryGrid = document.querySelector("[data-gallery-grid]");
    const gallerySeparator = document.querySelector(".gallery-separator");
    const bulkSelectButton = document.querySelector("[data-toggle-bulk-select]");
    const galleryDirectory = document.querySelector(".gallery-directory");
    const pathDescription = document.querySelector("[data-path-description]");
    let displayComicPage = () => {};

    function syncDescriptionHeight() {
        if (!pathDescription) {
            return;
        }

        if (window.matchMedia("(max-width: 991.98px)").matches || !galleryDirectory) {
            pathDescription.style.maxHeight = "";
            return;
        }

        pathDescription.style.maxHeight = `${Math.max(galleryDirectory.getBoundingClientRect().height, 400)}px`;
    }

    syncDescriptionHeight();
    if (galleryDirectory && pathDescription && "ResizeObserver" in window) {
        new ResizeObserver(syncDescriptionHeight).observe(galleryDirectory);
    }
    window.addEventListener("resize", syncDescriptionHeight);

    function setGalleryDisplayType(type) {
        const isComic = type === "comic";
        if (galleryGrid) {
            galleryGrid.hidden = isComic;
        }
        if (bulkSelectButton) {
            bulkSelectButton.hidden = isComic;
            const showNamesToggle = document.querySelector("[data-toggle-item-names]")?.closest("label");
            if (showNamesToggle) {
                showNamesToggle.hidden = isComic;
            }
            if (isComic) {
                galleryGrid.classList.remove("bulk-select-mode");
                document.querySelector("[data-bulk-selection-controls]").hidden = true;
                document.querySelectorAll("[data-bulk-select-item]").forEach((input) => { input.checked = false; });
            }
        }
        if (comicViewer) {
            comicViewer.hidden = !isComic;
            if (isComic) {
                displayComicPage(0);
            }
        }
        if (gallerySeparator) {
            gallerySeparator.hidden = !galleryGrid && !isComic;
        }
    }

    if (pathTypeSelect) {
        setGalleryDisplayType(pathTypeSelect.value);
    }

    if (comicViewer) {
        const pages = Array.from(comicViewer.querySelectorAll(".comic-pages [data-source]"));
        const image = comicViewer.querySelector("[data-comic-image]");
        const sourceLink = comicViewer.querySelector(".comic-source-link");
        const downloadLink = comicViewer.querySelector(".comic-download-link");
        const pageButtons = {
            first: comicViewer.querySelector("[data-comic-first]"),
            prev: comicViewer.querySelector("[data-comic-prev]"),
            next: comicViewer.querySelector("[data-comic-next]"),
            last: comicViewer.querySelector("[data-comic-last]")
        };
        let currentPage = 0;

        displayComicPage = (index) => {
            if (pages.length === 0) {
                return;
            }

            currentPage = Math.max(0, Math.min(index, pages.length - 1));
            const page = pages[currentPage];
            const imagePane = comicViewer.querySelector(".comic-image-pane");
            imagePane.classList.toggle("nsfw-blurred", page.dataset.blur === "true");
            imagePane.classList.toggle("nsfw-admin-item", page.dataset.nsfwAdmin === "true");
            imagePane.querySelector(".nsfw-preview-icon").hidden = page.dataset.blur !== "true";
            image.src = page.dataset.source;
            image.alt = page.dataset.name;
            sourceLink.href = page.dataset.source;
            downloadLink.href = page.dataset.source;
            downloadLink.download = page.dataset.name;
            pageButtons.first.disabled = currentPage === 0;
            pageButtons.prev.disabled = currentPage === 0;
            pageButtons.next.disabled = currentPage === pages.length - 1;
            pageButtons.last.disabled = currentPage === pages.length - 1;
        };

        pageButtons.first?.addEventListener("click", () => displayComicPage(0));
        pageButtons.prev?.addEventListener("click", () => displayComicPage(currentPage - 1));
        pageButtons.next?.addEventListener("click", () => displayComicPage(currentPage + 1));
        pageButtons.last?.addEventListener("click", () => displayComicPage(pages.length - 1));
        if (comicViewer && !comicViewer.hidden) {
            displayComicPage(0);
        }
    }

    document.addEventListener("change", async (event) => {
        const select = event.target.closest("[data-path-type-form] select[name='type']");
        if (!select) {
            return;
        }

        setGalleryDisplayType(select.value);
        const form = select.form;
        const status = form.querySelector("[data-path-type-status]");
        const previousValue = select.dataset.savedValue ?? "";
        status.textContent = "Saving...";
        try {
            const response = await fetch(form.action, {
                method: "POST",
                body: new FormData(form),
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            if (!response.ok) {
                throw new Error(await response.text() || "Saving display type failed.");
            }
            select.dataset.savedValue = select.value;
            status.textContent = "Saved";
        } catch (error) {
            select.value = previousValue;
            setGalleryDisplayType(previousValue);
            status.textContent = error.message;
        }
    });

    document.addEventListener("click", async (event) => {
        const openButton = event.target.closest("[data-open-description-editor]");
        if (openButton) {
            const dialog = document.querySelector("[data-description-editor]");
            dialog.querySelector("[data-description-preview-pane]").hidden = true;
            dialog.querySelector("[data-description-edit-pane]").hidden = false;
            dialog.querySelector("[data-description-editor-title]").textContent = "Edit Description";
            dialog.querySelector("[data-description-error]").textContent = "";
            dialog.showModal();
            dialog.querySelector("[data-description-markdown]").focus();
            return;
        }

        const descriptionPreview = event.target.closest("[data-open-description-viewer]");
        if (descriptionPreview) {
            event.preventDefault();
            const dialog = document.querySelector("[data-description-viewer]");
            dialog.querySelector("[data-full-description]").innerHTML = descriptionPreview.innerHTML;
            dialog.showModal();
            return;
        }

        if (event.target.closest("[data-close-description-viewer]")) {
            document.querySelector("[data-description-viewer]").close();
            return;
        }

        if (event.target.closest("[data-close-description-editor]")) {
            document.querySelector("[data-description-editor]").close();
            return;
        }

        if (event.target.closest("[data-edit-description]")) {
            const dialog = document.querySelector("[data-description-editor]");
            dialog.querySelector("[data-description-preview-pane]").hidden = true;
            dialog.querySelector("[data-description-edit-pane]").hidden = false;
            dialog.querySelector("[data-description-editor-title]").textContent = "Edit Description";
            dialog.querySelector("[data-description-markdown]").focus();
            return;
        }

        if (event.target.closest("[data-preview-description]")) {
            const dialog = event.target.closest("[data-description-editor]");
            const form = dialog.querySelector("[data-description-form]");
            const preview = form.querySelector("[data-description-preview]");
            const error = form.querySelector("[data-description-error]");
            const url = new URL(window.location.href);
            url.searchParams.set("handler", "PreviewDescription");
            error.textContent = "";

            try {
                const response = await fetch(url, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) {
                    throw new Error(await response.text() || "Preview failed.");
                }
                preview.innerHTML = await response.text();
                form.querySelector("[data-description-edit-pane]").hidden = true;
                form.querySelector("[data-description-preview-pane]").hidden = false;
                dialog.querySelector("[data-description-editor-title]").textContent = "Preview";
            } catch (requestError) {
                error.textContent = requestError.message;
            }
        }

    });

    document.addEventListener("keydown", (event) => {
        const preview = event.target.closest("[data-open-description-viewer]");
        if (preview && (event.key === "Enter" || event.key === " ")) {
            event.preventDefault();
            preview.click();
        }
    });

    document.addEventListener("submit", async (event) => {
        const tagForm = event.target.closest("[data-directory-tags-form]");
        if (tagForm) {
            event.preventDefault();
            const error = tagForm.querySelector("[data-directory-tag-error]");
            error.textContent = "";
            const url = new URL(window.location.href);
            url.searchParams.set("handler", "SaveDirectoryTags");

            try {
                const response = await fetch(url, {
                    method: "POST",
                    body: new FormData(tagForm),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) {
                    throw new Error(await response.text() || "Saving directory tags failed.");
                }

                const result = await response.json();
                tagForm.querySelector("input[name='tags']").value = result.tags.join(", ");
            } catch (requestError) {
                error.textContent = requestError.message;
            }
            return;
        }

        const form = event.target.closest("[data-description-form]");
        if (!form) {
            return;
        }

        event.preventDefault();
        const error = form.querySelector("[data-description-error]");
        error.textContent = "";
        const url = new URL(window.location.href);
        url.searchParams.set("handler", "SaveDescription");

        try {
            const response = await fetch(url, {
                method: "POST",
                body: new FormData(form),
                headers: { "X-Requested-With": "XMLHttpRequest" }
            });
            if (!response.ok) {
                throw new Error(await response.text() || "Save failed.");
            }

            const result = await response.json();
            const content = document.querySelector("[data-path-description]");
