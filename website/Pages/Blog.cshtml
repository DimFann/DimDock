@page "/blog"
@model Website.Pages.BlogModel
@{
    ViewData["Title"] = "Blog";
    ViewData["BodyClass"] = "content-background blog-layout";
}

<div class="blog-page">
    @if (Model.AdminEnabled)
    {
        <div class="admin-options-toolbar blog-admin-options-toolbar">
            <strong class="admin-options-toolbar-title">Admin Options</strong>
            <button type="button" class="path-admin-button" data-open-create-post>Post</button>
        </div>

        <dialog class="description-editor" data-create-post-dialog aria-labelledby="createPostTitle">
            <form method="post" asp-page-handler="Create" data-create-post-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="draftId" value="@Model.DraftId" />
                <section class="description-editor-pane" data-create-post-edit-pane>
                    <h2 id="createPostTitle">New blog post</h2>
                    <div class="description-editor-actions">
                        <div class="description-editor-actions-left">
                            <button type="button" class="icon-action-button" data-preview-create-post aria-label="Preview blog post" title="Preview">
                                <img src="/img/preview.png" alt="" />
                            </button>
                            <label class="blog-image-scale">
                                Image scale
                                <select data-create-post-image-scale aria-label="Image scale">
                                    <option value="25">25%</option>
                                    <option value="50" selected>50%</option>
                                    <option value="75">75%</option>
                                    <option value="100">100%</option>
                                </select>
                            </label>
                            <button type="button" class="description-editor-button" data-upload-create-post-image>
                                Upload image
                            </button>
                            <input type="file" accept=".gif,.jpeg,.jpg,.png,.webp,image/gif,image/jpeg,image/png,image/webp"
                                   data-create-post-image-input hidden multiple />
                        </div>
                        <div class="description-editor-actions-right">
                            <button type="button" class="icon-action-button" data-cancel-create-post aria-label="Cancel" title="Cancel">
                                <img src="/img/cancel.png" alt="" />
                            </button>
                            <button type="submit" class="icon-action-button" aria-label="Publish blog post" title="Publish">
                                <img src="/img/save.png" alt="" />
                            </button>
                        </div>
                    </div>
                    <input class="blog-create-title" name="title" maxlength="1024"
                           placeholder="Title (Untitled if empty)" aria-label="Post title" />
                    <div class="blog-image-dropzone" data-create-post-image-dropzone>
                        Drop images here, or use Upload image. Images are inserted as Markdown.
                    </div>
                    <p class="description-editor-error blog-image-upload-status" data-create-post-image-status role="status"></p>
                    <textarea name="content" maxlength="60000" data-create-post-content
                              aria-label="Blog post content in Markdown"></textarea>
                    <p class="blog-create-help">Content supports Markdown. The title is added as the post heading.</p>
                </section>
                <section class="description-editor-pane description-editor-preview-pane" data-create-post-preview-pane hidden>
                    <div class="description-editor-actions">
                        <div class="description-editor-actions-left">
                            <button type="button" class="icon-action-button" data-edit-create-post aria-label="Edit blog post" title="Edit">
                                <img src="/img/edit.png" alt="" />
                            </button>
                        </div>
                        <div class="description-editor-actions-right">
                            <button type="button" class="icon-action-button" data-cancel-create-post aria-label="Cancel" title="Cancel">
                                <img src="/img/cancel.png" alt="" />
                            </button>
                            <button type="submit" class="icon-action-button" aria-label="Publish blog post" title="Publish">
                                <img src="/img/save.png" alt="" />
                            </button>
                        </div>
                    </div>
                    <div class="description-editor-preview blog-post-content" data-create-post-preview aria-live="polite"></div>
                </section>
                <p class="description-editor-error" data-create-post-error role="alert"></p>
            </form>
        </dialog>
    }

    <div data-blog-results aria-live="polite">
        @await Html.PartialAsync("_BlogResults", Model)
    </div>

    @if (Model.AdminEnabled)
    {
        <dialog class="path-description-dialog path-admin-dialog" data-delete-blog-dialog aria-labelledby="deleteBlogTitle">
            <form method="post" asp-page-handler="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" />
                <input type="hidden" name="page" />
                <div class="path-description-dialog-header">
                    <h2 id="deleteBlogTitle">Delete Post?</h2>
                    <button type="button" class="icon-action-button" data-close-delete-blog aria-label="Close" title="Close">
                        <img src="/img/cancel.png" alt="" />
                    </button>
                </div>
                <p>This permanently deletes this post from the database. This cannot be undone.</p>
                <div class="path-admin-dialog-actions">
                    <button type="button" data-close-delete-blog>Cancel</button>
                    <button type="submit" class="path-admin-button path-admin-delete">Delete Post</button>
                </div>
            </form>
        </dialog>
    }
</div>

@section Scripts {
    <script>
        const createPostDialog = document.querySelector("[data-create-post-dialog]");
        const createPostForm = createPostDialog?.querySelector("[data-create-post-form]");
        const showCreatePostPane = (preview) => {
            createPostForm.querySelector("[data-create-post-edit-pane]").hidden = preview;
            createPostForm.querySelector("[data-create-post-preview-pane]").hidden = !preview;
        };
        document.querySelector("[data-open-create-post]")?.addEventListener("click", () => {
            showCreatePostPane(false);
            createPostForm.querySelector("[data-create-post-error]").textContent = "";
            createPostDialog.showModal();
            createPostDialog.querySelector("input[name='title']").focus();
        });
        createPostDialog?.querySelectorAll("[data-cancel-create-post]").forEach((button) => {
            button.addEventListener("click", () => createPostDialog.close());
        });
        if (createPostForm) {
            initializeMarkdownImageUploads({
                form: createPostForm,
                markdownEditor: createPostForm.querySelector("[data-create-post-content]"),
                input: createPostForm.querySelector("[data-create-post-image-input]"),
                status: createPostForm.querySelector("[data-create-post-image-status]"),
                scale: createPostForm.querySelector("[data-create-post-image-scale]"),
                uploadButton: createPostForm.querySelector("[data-upload-create-post-image]"),
                dropzone: createPostForm.querySelector("[data-create-post-image-dropzone]"),
                trackUploads: true
            });

            // Images uploaded to an unpublished draft are deleted when it is closed or the page is left.
            let publishingPost = false;
            const draftUploads = () => createPostForm.querySelectorAll("input[name='uploadedImageUrls']");
            const discardDraftData = () => {
                const data = new FormData();
                data.append("draftId", createPostForm.querySelector("input[name='draftId']").value);
                data.append("__RequestVerificationToken",
                    createPostForm.querySelector("input[name='__RequestVerificationToken']").value);
                draftUploads().forEach((input) => input.remove());
                return data;
            };
            const discardDraftUrl = () => {
                const url = new URL(window.location.href);
                url.search = "";
                url.searchParams.set("handler", "DiscardDraft");
                return url;
            };
            createPostForm.addEventListener("submit", (event) => {
                if (!event.defaultPrevented) {
                    publishingPost = true;
                }
            });
            createPostDialog.addEventListener("close", () => {
                createPostForm.querySelector("[data-create-post-image-status]").textContent = "";
                if (!publishingPost && draftUploads().length > 0) {
                    void fetch(discardDraftUrl(), { method: "POST", body: discardDraftData(), keepalive: true });
                }
            });
            window.addEventListener("pagehide", () => {
                if (!publishingPost && draftUploads().length > 0) {
                    navigator.sendBeacon(discardDraftUrl(), discardDraftData());
                }
            });
        }
        createPostDialog?.querySelector("[data-edit-create-post]")?.addEventListener("click", () => {
            showCreatePostPane(false);
            createPostForm.querySelector("textarea[name='content']").focus();
        });
        createPostDialog?.querySelector("[data-preview-create-post]")?.addEventListener("click", async () => {
            const error = createPostForm.querySelector("[data-create-post-error]");
            const url = new URL(window.location.href);
            url.search = "";
            url.searchParams.set("handler", "Preview");
            error.textContent = "";
            try {
                const response = await fetch(url, {
                    method: "POST",
                    body: new FormData(createPostForm),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) {
                    throw new Error(await response.text() || "Preview failed.");
                }
                createPostForm.querySelector("[data-create-post-preview]").innerHTML = await response.text();
                showCreatePostPane(true);
            } catch (requestError) {
                error.textContent = requestError.message;
            }
        });

        const blogResults = document.querySelector("[data-blog-results]");
        const deleteBlogDialog = document.querySelector("[data-delete-blog-dialog]");
        deleteBlogDialog?.querySelectorAll("[data-close-delete-blog]").forEach((button) => {
            button.addEventListener("click", () => deleteBlogDialog.close());
        });
        let activeBlogRequest = null;

        function formatBlogDates(container) {
            container.querySelectorAll("time[data-local-time]").forEach((element) => {
                const date = new Date(element.dateTime);
                if (!Number.isNaN(date.getTime())) {
                    element.textContent = date.toLocaleString();
                }
            });
        }

        async function loadBlogPage(url, updateHistory) {
            activeBlogRequest?.abort();
            const request = new AbortController();
            activeBlogRequest = request;
            blogResults.setAttribute("aria-busy", "true");

            try {
                const response = await fetch(url, {
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    signal: request.signal
                });
                if (!response.ok) {
                    throw new Error(`Blog page request failed (${response.status}).`);
                }

                const responseDocument = new DOMParser().parseFromString(await response.text(), "text/html");
                const newResults = responseDocument.querySelector("[data-blog-results]");
                if (!newResults) {
                    throw new Error("The requested blog page did not contain results.");
                }
                if (activeBlogRequest !== request) {
                    return;
                }

                blogResults.innerHTML = newResults.innerHTML;
                formatBlogDates(blogResults);
                if (updateHistory) {
                    history.pushState(null, "", url);
                }
            } catch (error) {
                if (error.name !== "AbortError" && activeBlogRequest === request) {
                    window.location.assign(url);
                }
            } finally {
                if (activeBlogRequest === request) {
                    activeBlogRequest = null;
                    blogResults.removeAttribute("aria-busy");
                }
            }
        }

        formatBlogDates(blogResults);
        blogResults.addEventListener("click", (event) => {
            const link = event.target.closest("a[data-blog-page]");
            if (!link) {
                return;
            }

            if (link.getAttribute("aria-disabled") === "true") {
                event.preventDefault();
                return;
            }
            if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) {
                return;
            }

            event.preventDefault();
            void loadBlogPage(link.href, true);
        });
        blogResults.addEventListener("submit", (event) => {
            if (event.target.matches("[data-delete-blog-form]")) {
                event.preventDefault();
                const sourceForm = event.target;
                const dialogForm = deleteBlogDialog.querySelector("form");
                dialogForm.querySelector("input[name='id']").value =
                    sourceForm.querySelector("input[name='id']").value;
                dialogForm.querySelector("input[name='page']").value =
                    sourceForm.querySelector("input[name='page']").value;
                deleteBlogDialog.showModal();
            }
        });
        window.addEventListener("popstate", () => void loadBlogPage(window.location.href, false));
    </script>
}
