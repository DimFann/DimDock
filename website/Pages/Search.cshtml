@page
@model Website.Pages.SearchModel
@using Website.Models
@{
    ViewData["Title"] = "Search by Tag";
    ViewData["BodyClass"] = "content-background";
}

<div class="gallery-page-container search-page-container">
    <div class="gallery-heading">
        <h4>Search by Tag</h4>
    </div>

    <form method="get" class="tag-search-form">
        <input id="tag" name="tag" value="@Model.Tag" aria-label="Search by tag" />
        <button type="submit">Search</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p class="search-message">@Model.Message</p>
    }

    @if (Model.DirectoryResults.Count > 0)
    {
        <h2>Directories</h2>
        <ul class="tag-search-directories">
            @foreach (var path in Model.DirectoryResults)
            {
                var displayPath = path.Path == "root" ? "/" : path.Path;
                var adminOnly = path.TagLinks.Any(link => Model.AdminOnlyTags.Contains(link.Tag.Name));
                <li>
                    <a class="@(adminOnly ? "admin-only-tagged" : "")"
                       href="@(path.Path == "root" ? "/Gallery" : $"/Gallery/{path.Path}")">@displayPath</a>
                    <span>— </span>
                    @await Html.PartialAsync("_TagLinks", new TagListModel(Model.GetPathTags(path)))
                </li>
            }
        </ul>
    }

    @if (Model.Results.Count > 0)
    {
        <h2>Files</h2>
        <div class="gallery-image-grid">
            @foreach (var item in Model.Results)
            {
                var adminOnly = item.TagLinks.Any(link => Model.AdminOnlyTags.Contains(link.Tag.Name));
                <div class="gallery-image-result @(adminOnly ? "admin-only-tagged" : "")">
                    <a href="@($"/image/{item.Id}")" class="gallery-image-link">
                        @if (item.IsImage)
                        {
                            <img src="@item.ThumbnailUrl" alt="@item.OriginalName"
                                 class="gallery-image-thumbnail" />
                        }
                        else
                        {
                            <span class="gallery-file-thumbnail">
                                <img src="/img/file.png" alt="" />
                                <span>@item.OriginalName</span>
                            </span>
                        }
                    </a>
                </div>
            }
        </div>
    }
</div>
