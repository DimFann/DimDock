@page
@model SearchModel
@{
    ViewData["Title"] = "Search";
}

<h2>Search</h2>

<form method="post">
    <label for="InputPath">Enter Path:</label>
    <input type="text" id="InputPath" name="InputPath" value="@Model.InputPath" />
    <button type="submit">Submit</button>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p class="search-message">@Model.Message</p>
}

@if (Model.Results.Any())
{
    <h3>Results for "@Model.InputPath"</h3>
    <div class="search-image-grid">
        @foreach (var item in Model.Results)
        {
            var ext = Model.GetExtension(item.OriginalName);
            <a href="@($"/img_db/{item.Id}.{ext}")" target="_blank" class="search-image-link">
                <img src="@($"/img_db_thumbs/{item.Id}.png")" alt="@item.OriginalName"
                    class="search-image-thumbnail" />
            </a>
        }
    </div>
}