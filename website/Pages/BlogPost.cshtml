@page "/blog/{slugOrId}"
@model Website.Pages.BlogPostModel
@using System.Globalization
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Post.Title) ? "Untitled" : Model.Post.Title;
    ViewData["BodyClass"] = "blog-background";
    var timestamp = Model.Post.Timestamp.HasValue
        ? DateTime.SpecifyKind(Model.Post.Timestamp.Value, DateTimeKind.Utc)
            .ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture)
        : null;
}

<div class="blog-page">
    <article class="blog-post blog-post-full">
        <div class="blog-post-heading">
            <h1 class="blog-post-title">@(string.IsNullOrWhiteSpace(Model.Post.Title) ? "Untitled" : Model.Post.Title)</h1>
            <a href="/blog">Back to blog</a>
        </div>
        <div class="blog-post-date">
            @if (timestamp is not null)
            {
                <time datetime="@timestamp" data-local-time>
                    @Model.Post.Timestamp!.Value.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
                </time>
            }
        </div>
        <div class="blog-post-content">
            @Html.Raw(Model.RenderMarkdown(Model.Post.Text))
        </div>
        @if (Model.AdminEnabled)
        {
            <div class="blog-post-admin">
                <button type="button" class="description-editor-button" data-open-blog-editor>Edit Post</button>
            </div>
        }
    </article>
</div>

@if (Model.AdminEnabled)
{
    <dialog class="description-editor" data-blog-editor aria-labelledby="blogEditorTitle">
        <form method="post" data-blog-form>
            @Html.AntiForgeryToken()
            <section class="description-editor-pane" data-blog-edit-pane>
                <h2 id="blogEditorTitle">Edit blog post Markdown</h2>
                <div class="description-editor-actions">
                    <button type="button" class="description-editor-button" data-preview-blog>Preview</button>
                    <button type="button" class="description-editor-button" data-close-blog-editor>Cancel</button>
                    <button type="submit" class="description-editor-button">Save</button>
                </div>
                <textarea name="markdown" data-blog-markdown aria-label="Blog post Markdown">@Model.Post.Text</textarea>
            </section>
            <section class="description-editor-pane description-editor-preview-pane" data-blog-preview-pane hidden>
                <div class="description-editor-actions">
                    <button type="button" class="description-editor-button" data-edit-blog>Edit</button>
                    <button type="submit" class="description-editor-button">Save</button>
                </div>
                <div class="description-editor-preview blog-post-content" data-blog-preview aria-live="polite"></div>
            </section>
            <p class="description-editor-error" data-blog-error role="alert"></p>
        </form>
    </dialog>
}

@section Scripts {
    <script>
        document.querySelectorAll("time[data-local-time]").forEach((element) => {
            const date = new Date(element.dateTime);
            if (!Number.isNaN(date.getTime())) {
                element.textContent = date.toLocaleString();
            }
        });

        const blogEditor = document.querySelector("[data-blog-editor]");
        if (blogEditor) {
            document.addEventListener("click", async (event) => {
                if (event.target.closest("[data-open-blog-editor]")) {
                    blogEditor.querySelector("[data-blog-preview-pane]").hidden = true;
                    blogEditor.querySelector("[data-blog-edit-pane]").hidden = false;
                    blogEditor.querySelector("[data-blog-error]").textContent = "";
                    blogEditor.showModal();
                    blogEditor.querySelector("[data-blog-markdown]").focus();
                } else if (event.target.closest("[data-close-blog-editor]")) {
                    blogEditor.close();
                } else if (event.target.closest("[data-edit-blog]")) {
                    blogEditor.querySelector("[data-blog-preview-pane]").hidden = true;
                    blogEditor.querySelector("[data-blog-edit-pane]").hidden = false;
                    blogEditor.querySelector("[data-blog-markdown]").focus();
                } else if (event.target.closest("[data-preview-blog]")) {
                    const form = blogEditor.querySelector("[data-blog-form]");
                    const error = form.querySelector("[data-blog-error]");
                    const url = new URL(window.location.href);
                    url.searchParams.set("handler", "Preview");
                    error.textContent = "";

                    try {
                        const response = await fetch(url, {
                            method: "POST",
                            body: new FormData(form),
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });
                        if (!response.ok) {
                            throw new Error(await response.text() || "Preview failed.");
                        }
                        form.querySelector("[data-blog-preview]").innerHTML = await response.text();
                        form.querySelector("[data-blog-edit-pane]").hidden = true;
                        form.querySelector("[data-blog-preview-pane]").hidden = false;
                    } catch (requestError) {
                        error.textContent = requestError.message;
                    }
                }
            });

            blogEditor.querySelector("[data-blog-form]").addEventListener("submit", async (event) => {
                event.preventDefault();
                const form = event.currentTarget;
                const error = form.querySelector("[data-blog-error]");
                const url = new URL(window.location.href);
                url.searchParams.set("handler", "Save");
                error.textContent = "";

                try {
                    const response = await fetch(url, {
                        method: "POST",
                        body: new FormData(form),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!response.ok) {
                        throw new Error(await response.text() || "Save failed.");
                    }

                    const result = await response.json();
                    document.querySelector(".blog-post-title").textContent = result.title;
                    document.querySelector(".blog-post-content").innerHTML = result.html;
                    blogEditor.close();
                } catch (requestError) {
                    error.textContent = requestError.message;
                }
            });
        }
    </script>
}
