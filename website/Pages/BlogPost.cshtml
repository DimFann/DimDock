@page "/blog/{slugOrId}"
@model Website.Pages.BlogPostModel
@using System.Globalization
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Post.Title) ? "Untitled" : Model.Post.Title;
    ViewData["BodyClass"] = "content-background";
    var timestamp = Model.Post.Timestamp.HasValue
        ? DateTime.SpecifyKind(Model.Post.Timestamp.Value, DateTimeKind.Utc)
            .ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture)
        : null;
}

<div class="blog-page">
    @if (Model.AdminEnabled)
    {
        <div class="admin-options-toolbar blog-admin-options-toolbar">
            <strong class="admin-options-toolbar-title">Admin Options</strong>
            <button type="button" class="path-admin-button path-admin-delete" data-open-delete-post>
                Delete Post
            </button>
        </div>
    }

    <article class="blog-post blog-post-full">
        <div class="blog-post-heading">
            <div class="blog-post-title-row">
                <h1 class="blog-post-title">@(string.IsNullOrWhiteSpace(Model.Post.Title) ? "Untitled" : Model.Post.Title)</h1>
                @if (Model.AdminEnabled)
                {
                    <button type="button" class="icon-action-button blog-post-title-edit"
                            data-open-title-editor aria-label="Edit post title" title="Edit title">
                        <img src="/img/edit.png" alt="" />
                    </button>
                }
            </div>
            <a class="icon-action-button soft-shadow" href="/blog" aria-label="Back to blog" title="Back to blog">
                <img src="/img/prev.png" alt="" />
            </a>
        </div>
        <div class="blog-post-date">
            @if (timestamp is not null)
            {
                <time datetime="@timestamp" data-local-time>
                    @Model.Post.Timestamp!.Value.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
                </time>
            }
        </div>
        <div class="blog-post-content-wrapper">
            <div class="blog-post-content">
                @Html.Raw(Model.RenderMarkdown(Model.Post.Text))
            </div>
            @if (Model.AdminEnabled)
            {
                <button type="button"
                        class="description-editor-button description-edit-icon"
                        data-open-blog-editor
                        aria-label="Edit blog post"
                        title="Edit blog post">
                    <img src="/img/edit.png" alt="" />
                </button>
            }
        </div>
    </article>
</div>

@if (Model.AdminEnabled)
{
    <dialog class="path-description-dialog path-admin-dialog" data-title-editor aria-labelledby="editTitleHeading">
        <form method="post" data-title-form>
            @Html.AntiForgeryToken()
            <div class="path-description-dialog-header">
                <h2 id="editTitleHeading">Edit Post Title</h2>
                <button type="button" class="icon-action-button" data-close-title-editor aria-label="Close" title="Close">
                    <img src="/img/cancel.png" alt="" />
                </button>
            </div>
            <label class="path-admin-field">
                Title
                <input name="title" value="@Model.Post.Title" maxlength="1024" required />
            </label>
            <p class="description-editor-error" data-title-error role="alert"></p>
            <div class="path-admin-dialog-actions">
                <button type="button" data-close-title-editor>Cancel</button>
                <button type="submit">Save title</button>
            </div>
        </form>
    </dialog>

    <dialog class="path-description-dialog path-admin-dialog" data-delete-post-dialog aria-labelledby="deletePostTitle">
        <form method="post" asp-page-handler="Delete">
            @Html.AntiForgeryToken()
            <div class="path-description-dialog-header">
                <h2 id="deletePostTitle">Delete Post?</h2>
                <button type="button" class="icon-action-button" data-close-delete-post aria-label="Close" title="Close">
                    <img src="/img/cancel.png" alt="" />
                </button>
            </div>
            <p>This permanently deletes this post from the database. This cannot be undone.</p>
            <div class="path-admin-dialog-actions">
                <button type="button" data-close-delete-post>Cancel</button>
                <button type="submit" class="path-admin-button path-admin-delete">Delete Post</button>
            </div>
        </form>
    </dialog>

    <dialog class="description-editor" data-blog-editor aria-labelledby="blogEditorTitle">
        <form method="post" data-blog-form>
            @Html.AntiForgeryToken()
            <section class="description-editor-pane" data-blog-edit-pane>
                <h2 id="blogEditorTitle">Edit blog post Markdown</h2>
                <div class="description-editor-actions">
                    <div class="description-editor-actions-left">
                        <button type="button" class="icon-action-button" data-preview-blog aria-label="Preview blog post" title="Preview">
                            <img src="/img/preview.png" alt="" />
                        </button>
                        <label class="blog-image-scale">
                            Image scale
                            <select data-blog-image-scale aria-label="Image scale">
                                <option value="25">25%</option>
                                <option value="50" selected>50%</option>
                                <option value="75">75%</option>
                                <option value="100">100%</option>
                            </select>
                        </label>
                        <button type="button" class="description-editor-button" data-upload-blog-image>
                            Upload image
                        </button>
                        <input type="file" accept=".gif,.jpeg,.jpg,.png,.webp,image/gif,image/jpeg,image/png,image/webp"
                               data-blog-image-input hidden multiple />
                    </div>
                    <div class="description-editor-actions-right">
                        <button type="button" class="icon-action-button" data-close-blog-editor aria-label="Cancel editing" title="Cancel">
                            <img src="/img/cancel.png" alt="" />
                        </button>
                        <button type="submit" class="icon-action-button" aria-label="Save blog post" title="Save">
                            <img src="/img/save.png" alt="" />
                        </button>
                    </div>
                </div>
                <div class="blog-image-dropzone" data-blog-image-dropzone>
                    Drop images here, or use Upload image. Images are inserted as Markdown.
                </div>
                <p class="description-editor-error blog-image-upload-status" data-blog-image-status role="status"></p>
                <textarea name="markdown" data-blog-markdown aria-label="Blog post Markdown">@Model.Post.Text</textarea>
            </section>
            <section class="description-editor-pane description-editor-preview-pane" data-blog-preview-pane hidden>
                <div class="description-editor-actions">
                    <div class="description-editor-actions-left">
                        <button type="button" class="icon-action-button" data-edit-blog aria-label="Edit blog post" title="Edit">
                            <img src="/img/edit.png" alt="" />
                        </button>
                    </div>
                    <div class="description-editor-actions-right">
                        <button type="button" class="icon-action-button" data-close-blog-editor aria-label="Cancel editing" title="Cancel">
                            <img src="/img/cancel.png" alt="" />
                        </button>
                        <button type="submit" class="icon-action-button" aria-label="Save blog post" title="Save">
                            <img src="/img/save.png" alt="" />
                        </button>
                    </div>
                </div>
                <div class="description-editor-preview blog-post-content" data-blog-preview aria-live="polite"></div>
            </section>
            <p class="description-editor-error" data-blog-error role="alert"></p>
        </form>
    </dialog>
}

@section Scripts {
    <script>
        document.querySelectorAll("time[data-local-time]").forEach((element) => {
            const date = new Date(element.dateTime);
            if (!Number.isNaN(date.getTime())) {
                element.textContent = date.toLocaleString();
            }
        });

        const blogEditor = document.querySelector("[data-blog-editor]");
        const titleEditor = document.querySelector("[data-title-editor]");
        const deletePostDialog = document.querySelector("[data-delete-post-dialog]");
        document.querySelector("[data-open-title-editor]")?.addEventListener("click", () => {
            titleEditor.showModal();
            titleEditor.querySelector("input[name='title']").focus();
        });
        titleEditor?.querySelectorAll("[data-close-title-editor]").forEach((button) => {
            button.addEventListener("click", () => titleEditor.close());
        });
        document.querySelector("[data-open-delete-post]")?.addEventListener("click", () => deletePostDialog.showModal());
        deletePostDialog?.querySelectorAll("[data-close-delete-post]").forEach((button) => {
            button.addEventListener("click", () => deletePostDialog.close());
        });
        titleEditor?.querySelector("[data-title-form]").addEventListener("submit", async (event) => {
            event.preventDefault();
            const form = event.currentTarget;
            const error = form.querySelector("[data-title-error]");
            const url = new URL(window.location.href);
            url.searchParams.set("handler", "SaveTitle");
            error.textContent = "";

            try {
                const response = await fetch(url, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (!response.ok) {
                    throw new Error(await response.text() || "Saving the title failed.");
                }

                const result = await response.json();
                document.querySelector(".blog-post-title").textContent = result.title;
                document.querySelector(".blog-post-content").innerHTML = result.html;
                const titleSeparator = document.title.indexOf(" - ");
                document.title = `${result.title}${titleSeparator >= 0 ? document.title.substring(titleSeparator) : ""}`;
                titleEditor.close();
            } catch (requestError) {
                error.textContent = requestError.message;
            }
        });

        if (blogEditor) {
            const blogForm = blogEditor.querySelector("[data-blog-form]");
            const markdownEditor = blogEditor.querySelector("[data-blog-markdown]");
            const imageInput = blogEditor.querySelector("[data-blog-image-input]");
            const imageStatus = blogEditor.querySelector("[data-blog-image-status]");

            async function uploadBlogImages(files) {
                for (const file of files) {
                    imageStatus.textContent = `Uploading ${file.name}...`;
                    const formData = new FormData(blogForm);
                    formData.append("image", file);
                    const url = new URL(window.location.href);
                    url.searchParams.set("handler", "UploadImage");

                    try {
                        const response = await fetch(url, {
                            method: "POST",
                            body: formData,
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });
                        if (!response.ok) {
                            throw new Error(await response.text() || "Image upload failed.");
                        }

                        const result = await response.json();
                        const altText = result.fileName
                            .replaceAll("\\", "\\\\")
                            .replaceAll("]", "\\]")
                            .replace(/[\r\n]/g, " ");
                        const scale = blogEditor.querySelector("[data-blog-image-scale]").value;
                        const imageMarkdown = `![${altText}](${result.url} "scale=${scale}%")`;
                        const start = markdownEditor.selectionStart;
                        const end = markdownEditor.selectionEnd;
                        const before = start > 0 && markdownEditor.value[start - 1] !== "\n" ? "\n" : "";
                        const after = end < markdownEditor.value.length && markdownEditor.value[end] !== "\n" ? "\n" : "";
                        markdownEditor.setRangeText(`${before}${imageMarkdown}${after}`, start, end, "end");
                        markdownEditor.focus();
                        imageStatus.textContent = `Uploaded ${file.name}.`;
                    } catch (requestError) {
                        imageStatus.textContent = requestError.message;
                    }
                }
            }

            blogEditor.querySelector("[data-upload-blog-image]").addEventListener("click", () => imageInput.click());
            imageInput.addEventListener("change", () => {
                void uploadBlogImages(Array.from(imageInput.files));
                imageInput.value = "";
            });
            const imageDropzone = blogEditor.querySelector("[data-blog-image-dropzone]");
            imageDropzone.addEventListener("dragover", (event) => {
                event.preventDefault();
                imageDropzone.classList.add("is-dragging");
            });
            imageDropzone.addEventListener("dragleave", (event) => {
                if (!imageDropzone.contains(event.relatedTarget)) {
                    imageDropzone.classList.remove("is-dragging");
                }
            });
            imageDropzone.addEventListener("drop", (event) => {
                event.preventDefault();
                imageDropzone.classList.remove("is-dragging");
                void uploadBlogImages(Array.from(event.dataTransfer.files));
            });

            document.addEventListener("click", async (event) => {
                if (event.target.closest("[data-open-blog-editor]")) {
                    blogEditor.querySelector("[data-blog-preview-pane]").hidden = true;
                    blogEditor.querySelector("[data-blog-edit-pane]").hidden = false;
                    blogEditor.querySelector("[data-blog-error]").textContent = "";
                    blogEditor.showModal();
                    blogEditor.querySelector("[data-blog-markdown]").focus();
                } else if (event.target.closest("[data-close-blog-editor]")) {
                    blogEditor.close();
                } else if (event.target.closest("[data-edit-blog]")) {
                    blogEditor.querySelector("[data-blog-preview-pane]").hidden = true;
                    blogEditor.querySelector("[data-blog-edit-pane]").hidden = false;
                    blogEditor.querySelector("[data-blog-markdown]").focus();
                } else if (event.target.closest("[data-preview-blog]")) {
                    const form = blogEditor.querySelector("[data-blog-form]");
                    const error = form.querySelector("[data-blog-error]");
                    const url = new URL(window.location.href);
                    url.searchParams.set("handler", "Preview");
                    error.textContent = "";

                    try {
                        const response = await fetch(url, {
                            method: "POST",
                            body: new FormData(form),
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });
                        if (!response.ok) {
                            throw new Error(await response.text() || "Preview failed.");
                        }
                        form.querySelector("[data-blog-preview]").innerHTML = await response.text();
                        form.querySelector("[data-blog-edit-pane]").hidden = true;
                        form.querySelector("[data-blog-preview-pane]").hidden = false;
                    } catch (requestError) {
                        error.textContent = requestError.message;
                    }
                }
            });

            blogEditor.querySelector("[data-blog-form]").addEventListener("submit", async (event) => {
                event.preventDefault();
                const form = event.currentTarget;
                const error = form.querySelector("[data-blog-error]");
                const url = new URL(window.location.href);
                url.searchParams.set("handler", "Save");
                error.textContent = "";

                try {
                    const response = await fetch(url, {
                        method: "POST",
                        body: new FormData(form),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!response.ok) {
                        throw new Error(await response.text() || "Save failed.");
                    }

                    const result = await response.json();
                    document.querySelector(".blog-post-title").textContent = result.title;
                    document.querySelector(".blog-post-content").innerHTML = result.html;
                    blogEditor.close();
                } catch (requestError) {
                    error.textContent = requestError.message;
                }
            });
        }
    </script>
}
