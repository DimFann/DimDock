@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "content-background";
}

<article class="about-page">
    <div class="blog-post-content-wrapper">
        <div class="blog-post-content" data-about-content>
            @Html.Raw(Model.RenderMarkdown(Model.AboutMarkdown))
        </div>
        @if (Model.AdminEnabled)
        {
            <button type="button"
                    class="description-editor-button description-edit-icon"
                    data-open-about-editor
                    aria-label="Edit About content"
                    title="Edit About content">
                <img src="/img/edit.png" alt="" />
            </button>
        }
    </div>
</article>

@if (Model.AdminEnabled)
{
    <dialog class="description-editor" data-about-editor aria-labelledby="aboutEditorTitle">
        <form method="post" data-about-form>
            @Html.AntiForgeryToken()
            <section class="description-editor-pane" data-about-edit-pane>
                <h2 id="aboutEditorTitle">Edit About Markdown</h2>
                <div class="description-editor-actions">
                    <div class="description-editor-actions-left">
                        <button type="button" class="icon-action-button" data-preview-about aria-label="Preview About content" title="Preview">
                            <img src="/img/preview.png" alt="" />
                        </button>
                    </div>
                    <div class="description-editor-actions-right">
                        <button type="button" class="icon-action-button" data-close-about aria-label="Cancel editing" title="Cancel">
                            <img src="/img/cancel.png" alt="" />
                        </button>
                        <button type="submit" class="icon-action-button" aria-label="Save About content" title="Save">
                            <img src="/img/save.png" alt="" />
                        </button>
                    </div>
                </div>
                <textarea name="markdown" data-about-markdown aria-label="About Markdown">@Model.AboutMarkdown</textarea>
            </section>
            <section class="description-editor-pane description-editor-preview-pane" data-about-preview-pane hidden>
                <div class="description-editor-actions">
                    <div class="description-editor-actions-left">
                        <button type="button" class="icon-action-button" data-edit-about aria-label="Edit About content" title="Edit">
                            <img src="/img/edit.png" alt="" />
                        </button>
                    </div>
                    <div class="description-editor-actions-right">
                        <button type="button" class="icon-action-button" data-close-about aria-label="Cancel editing" title="Cancel">
                            <img src="/img/cancel.png" alt="" />
                        </button>
                        <button type="submit" class="icon-action-button" aria-label="Save About content" title="Save">
                            <img src="/img/save.png" alt="" />
                        </button>
                    </div>
                </div>
                <div class="description-editor-preview blog-post-content" data-about-preview aria-live="polite"></div>
            </section>
            <p class="description-editor-error" data-about-error role="alert"></p>
        </form>
    </dialog>
}

@section Scripts {
    @if (Model.AdminEnabled)
    {
        <script>
            const aboutEditor = document.querySelector("[data-about-editor]");
            const aboutForm = aboutEditor.querySelector("[data-about-form]");

            document.addEventListener("click", async (event) => {
                if (event.target.closest("[data-open-about-editor]")) {
                    aboutEditor.querySelector("[data-about-preview-pane]").hidden = true;
                    aboutEditor.querySelector("[data-about-edit-pane]").hidden = false;
                    aboutEditor.querySelector("[data-about-error]").textContent = "";
                    aboutEditor.showModal();
                    aboutEditor.querySelector("[data-about-markdown]").focus();
                } else if (event.target.closest("[data-close-about]")) {
                    aboutEditor.close();
                } else if (event.target.closest("[data-edit-about]")) {
                    aboutEditor.querySelector("[data-about-preview-pane]").hidden = true;
                    aboutEditor.querySelector("[data-about-edit-pane]").hidden = false;
                    aboutEditor.querySelector("[data-about-markdown]").focus();
                } else if (event.target.closest("[data-preview-about]")) {
                    const error = aboutForm.querySelector("[data-about-error]");
                    const url = new URL(window.location.href);
                    url.searchParams.set("handler", "Preview");
                    error.textContent = "";

                    try {
                        const response = await fetch(url, {
                            method: "POST",
                            body: new FormData(aboutForm),
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });
                        if (!response.ok) {
                            throw new Error(await response.text() || "Preview failed.");
                        }
                        aboutForm.querySelector("[data-about-preview]").innerHTML = await response.text();
                        aboutForm.querySelector("[data-about-edit-pane]").hidden = true;
                        aboutForm.querySelector("[data-about-preview-pane]").hidden = false;
                    } catch (error) {
                        aboutForm.querySelector("[data-about-error]").textContent = error.message;
                    }
                }
            });

            aboutForm.addEventListener("submit", async (event) => {
                event.preventDefault();
                const error = aboutForm.querySelector("[data-about-error]");
                const url = new URL(window.location.href);
                url.searchParams.set("handler", "Save");
                error.textContent = "";

                try {
                    const response = await fetch(url, {
                        method: "POST",
                        body: new FormData(aboutForm),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!response.ok) {
                        throw new Error(await response.text() || "Save failed.");
                    }
                    const result = await response.json();
                    document.querySelector("[data-about-content]").innerHTML = result.html;
                    aboutEditor.close();
                } catch (requestError) {
                    error.textContent = requestError.message;
                }
            });
        </script>
    }
}
