@page
@model Website.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "content-background";
}

<section class="admin-login">
    @if (!Model.AdminFeatureEnabled)
    {
        <p>Admin access is disabled for this site.</p>
    }
    else if (!Model.CredentialsConfigured)
    {
        @if (Model.DevelopmentPasswordBypassEnabled)
        {
            <p>Admin access is not configured. Set <code>ADMIN_USERNAME</code> in your environment, then restart the website.</p>
        }
        else
        {
            <p>Admin access is not configured. Set <code>ADMIN_USERNAME</code> and <code>ADMIN_PASSWORD</code> (at least 12 characters) in your environment, then restart the website.</p>
        }
    }
    else
    {
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <label asp-for="Username">Username</label>
            <input asp-for="Username" autocomplete="username" required />
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" required />
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p class="admin-login-error" role="alert">@Model.ErrorMessage</p>
            }
            <button type="submit">Sign in</button>
        </form>
    }
</section>
