# Set this to the absolute path of the self-hosted data directory.
DATA_DIR=C:/path/to/dimdock-selfhost-data
# For Docker running in WSL2, set this to the
# same directory using a path visible to that engine, such as /mnt/c/path/to/dimdock-selfhost-data.
# WSL_DATA_DIR=/mnt/c/path/to/dimdock-selfhost-data
# Also set this to the repository path visible to the engine, such as /mnt/c/path/to/DimDock.
# WSL_PROJECT_DIR=/mnt/c/path/to/DimDock
WEBSITE_PORT=18080
