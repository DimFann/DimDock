# Set this to the absolute path of the self-hosted data directory.
DATA_DIR=C:/path/to/dimdock-selfhost-data
# For Docker running in WSL2, set this to the
# same directory using a path visible to that engine, such as /mnt/c/path/to/dimdock-selfhost-data.
# WSL_DATA_DIR=/mnt/c/path/to/dimdock-selfhost-data
# Also set this to the repository path visible to the engine, such as /mnt/c/path/to/DimDock.
# WSL_PROJECT_DIR=/mnt/c/path/to/DimDock
WEBSITE_PORT=18080
THUMBNAIL_SERVICE_PORT=8080
# Skip content imports on an already-initialized database; prefer setting this per command.
PATH_LOADER_FAST=false
# Local remains the default. Set Linode only after copying and verifying content.
FILE_STORAGE_PROVIDER=Local
# Container path for the shared data volume. Keep the existing DATA_DIR layout.
FILE_STORAGE_ROOT=/data
# Linode Object Storage S3 endpoint (no bucket name/path), signing region and bucket.
# Keep credentials in the untracked .env only; use a bucket-scoped read/write key.
LINODE_STORAGE_ENDPOINT=
LINODE_STORAGE_REGION=
LINODE_STORAGE_BUCKET=
# Optional namespace inside the bucket, without a leading/trailing slash.
LINODE_STORAGE_PREFIX=
LINODE_STORAGE_ACCESS_KEY=
LINODE_STORAGE_SECRET_KEY=
# Gallery upload mode (works with both Local and Linode storage):
#   Chunked - files go through the main site in chunks, so each request stays under CDN/proxy body limits.
#   Bypass  - files are posted whole to UPLOAD_BYPASS_HOST, a hostname that is NOT proxied by the CDN
#             (DNS-only record with its own TLS certificate). The Upload button on the main site links there.
UPLOAD_MODE=Chunked
# Required when UPLOAD_MODE=Bypass, e.g. upload.example.com (hostname only, no scheme or path).
UPLOAD_BYPASS_HOST=
# Header navigation on the upload host returns to this main site origin.
MAIN_SITE_URL=https://dimdock.com
# Chunked mode request size in MB (5-95). Keep it below your CDN limit (Cloudflare: 100 MB) and proxy limit.
UPLOAD_CHUNK_SIZE_MB=50
# Set distinct, strong values for the database and root credentials.
DB_ROOT_PASSWORD=
DB_NAME=mydb
DB_USER=dimdock
DB_PASSWORD=
# Set deployment-specific admin credentials in your untracked .env file.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional shared admin login across this domain and ALL its subdomains.
# Leave blank for host-only cookies. Use only if every subdomain is trusted.
# Example: dimdock.com shares login with upload.dimdock.com; HTTPS is required.
ADMIN_COOKIE_DOMAIN=
# Development-only password bypass. It is ignored unless ASPNETCORE_ENVIRONMENT=Development.
DEV_ALLOW_ANY_ADMIN_PASSWORD=false
# Keep Production for self-hosted deployments; only set Development for local testing.
ASPNETCORE_ENVIRONMENT=Production
# Optional: used only by gdrive_scripts. The folder ID is the gallery root from its sharing URL.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_ROOT_RESOURCE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
