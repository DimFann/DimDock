# Set this to the absolute path of the self-hosted data directory.
DATA_DIR=C:/path/to/dimdock-selfhost-data
# For Docker running in WSL2, set this to the
# same directory using a path visible to that engine, such as /mnt/c/path/to/dimdock-selfhost-data.
# WSL_DATA_DIR=/mnt/c/path/to/dimdock-selfhost-data
# Also set this to the repository path visible to the engine, such as /mnt/c/path/to/DimDock.
# WSL_PROJECT_DIR=/mnt/c/path/to/DimDock
WEBSITE_PORT=18080
THUMBNAIL_SERVICE_PORT=8080
# Set distinct, strong values for the database and root credentials.
DB_ROOT_PASSWORD=
DB_NAME=mydb
DB_USER=dimdock
DB_PASSWORD=
# Set deployment-specific admin credentials in your untracked .env file.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Development-only password bypass. It is ignored unless ASPNETCORE_ENVIRONMENT=Development.
DEV_ALLOW_ANY_ADMIN_PASSWORD=false
# Keep Production for self-hosted deployments; only set Development for local testing.
ASPNETCORE_ENVIRONMENT=Production
